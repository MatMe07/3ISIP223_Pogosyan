<Window x:Class="_3ISIP223_PogosyanWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF"
        mc:Ignorable="d"
        Title="Arina" Height="450" Width="800" KeyDown="Window_KeyDown">
    <Window.Resources>
        <local:LookBackConverter x:Key="lookBack"/>
    </Window.Resources>

    <Grid>
        <!--<StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="ПОДЗЕМЕЛЬЕ РОКА" FontSize="30"/>
            <Border Width="140" Margin="0 10">
                <Button Content="Start" FontSize="16"/>
            </Border>
        </StackPanel>-->
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel HorizontalAlignment="Center" Grid.Row="0">
            <TextBlock Text="hello" x:Name="pos"/>

        </StackPanel>

        <Border x:Name="Curs" Grid.Row="1" Panel.ZIndex="1" BorderThickness="1" Background="White" CornerRadius="5" Width="6" Height="6"/>
        <Viewport3D  x:Name="Viewport" Cursor="Arrow" Grid.Row="1" MouseMove="Viewport3D_MouseMove" MouseLeftButtonDown="Viewport3D_MouseLeftButtonDown" > 

            <Viewport3D.Camera>
                <PerspectiveCamera
            Position="0, 1, 1"   
            LookDirection="1, 0, -5"
            FieldOfView="70" />
            </Viewport3D.Camera>

            
            
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <DirectionalLight Color="#FFFFFF" Direction="-0.5, -1, -1" />
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <DirectionalLight Color="#CCCCCC" Direction="0.5, -0.5, 0.5" />
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <GeometryModel3D>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial Brush="Black"/>
                        </GeometryModel3D.Material>
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D 
                        Positions="-3, 0, 1.5   -3, 3, 1.5   3, 0, 1.5   3, 3, 1.5"
                        TriangleIndices="1,0,2  1,2,3" />
                        </GeometryModel3D.Geometry>
                    </GeometryModel3D>
                </ModelVisual3D.Content>

                <ModelVisual3D.Transform>
                    <TranslateTransform3D x:Name="translate"  OffsetZ="-15" OffsetX="2" />
                </ModelVisual3D.Transform>
            </ModelVisual3D>


            <ModelUIElement3D   x:Name="enem" MouseDown="ModelUIElement3D_MouseDown">
                <ModelUIElement3D.Model>
                    <GeometryModel3D>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial Brush="Red" />
                        </GeometryModel3D.Material>
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D
                                Positions="
                                                -0.5, -0.5, -0.5   0.5, -0.5, -0.5   -0.5, 0.5, -0.5   0.5, 0.5, -0.5  
                -0.5, -0.5, 0.5    0.5, -0.5, 0.5    -0.5, 0.5, 0.5    0.5, 0.5, 0.5     
                -0.5, -0.5, -0.5   -0.5, 0.5, -0.5   -0.5, -0.5, 0.5   -0.5, 0.5, 0.5   
                0.5, -0.5, -0.5    0.5, 0.5, -0.5    0.5, -0.5, 0.5    0.5, 0.5, 0.5     
                -0.5, -0.5, -0.5   -0.5, -0.5, 0.5   0.5, -0.5, -0.5   0.5, -0.5, 0.5   
                -0.5, 0.5, -0.5    -0.5, 0.5, 0.5    0.5, 0.5, -0.5    0.5, 0.5, 0.5"    
                                
                                            TriangleIndices="
                0,2,1  1,2,3    
                4,5,6  5,7,6     
                8,10,9 9,10,11   
                12,13,14 13,15,14 
                16,17,18 17,19,18 
                20,21,22 21,23,22 
        "
                                />
                        </GeometryModel3D.Geometry>
                    </GeometryModel3D>
                </ModelUIElement3D.Model>
                <ModelUIElement3D.Transform>
                    <TranslateTransform3D  OffsetZ="-10" OffsetX="3" />
                </ModelUIElement3D.Transform>
            </ModelUIElement3D>
            
            

            <!-- 3. ПОЛ -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <GeometryModel3D>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial Brush="#A0A0A0"/>
                        </GeometryModel3D.Material>
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D 
                        Positions="-10, 0, -15   10, 0, -15   -1.5, 0, 1.5   1.5, 0, 1.5"
                        TriangleIndices="0,2,1  1,2,3" />
                        </GeometryModel3D.Geometry>
                    </GeometryModel3D>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <AmbientLight Color="#303030"/>
                </ModelVisual3D.Content>
            </ModelVisual3D>
            <!-- 4. ПОТОЛОК (ДОБАВЛЕН) -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <GeometryModel3D>
                        <!-- Материал потолка (светло-бежевый) -->
                        <GeometryModel3D.Material>
                            <DiffuseMaterial Brush="ForestGreen"/>
                        </GeometryModel3D.Material>
                        <!--<GeometryModel3D.BackMaterial>
                            --><!-- На случай, если заглянем сверху --><!--
                            <DiffuseMaterial Brush="Gray"/>
                        </GeometryModel3D.BackMaterial>-->
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D 
                        Positions="-10, 1.5, -15   10, 1.5, -15   -1.5, 1.5, 1.5   1.5, 1.5, 1.5"
                        TriangleIndices="0,1,2 1,3,2" />
                            <!-- Объяснение: Смотрим на потолок снизу, поэтому порядок обхода должен быть
                         по часовой стрелке (чтобы нормаль смотрела вниз). 
                         Комбинация 1,2,0 и 3,2,1 создает правильную ориентацию. -->
                        </GeometryModel3D.Geometry>
                    </GeometryModel3D>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- 5. ЛЕВАЯ СТЕНА (X = -1.5) - ИСПРАВЛЕНА -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <GeometryModel3D>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial Brush="#5D9B9B"/>
                        </GeometryModel3D.Material>
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D 
                        Positions="1, 0, -15   1, 1.5, -15   -1, 0, 2   -1, 1.5, 1.5"
                        TriangleIndices="0,1,2  1,3,2" />
                        </GeometryModel3D.Geometry>
                    </GeometryModel3D>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- 6. ПРАВАЯ СТЕНА (X = +1.5) - ИСПРАВЛЕНА -->
            <ModelVisual3D>
                <ModelVisual3D.Content>
                    <GeometryModel3D>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial Brush="#9B5D5D"/>
                        </GeometryModel3D.Material>
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D 
                        Positions="4.07, 0, -15   4, 1.5, -15   1.5, 0, 1.5   1.25, 1.5, 1.5"
                        TriangleIndices="1,0,2  1,2,3" />
                        </GeometryModel3D.Geometry>
                    </GeometryModel3D>
                </ModelVisual3D.Content>
            </ModelVisual3D>

            <!-- 7. ДАЛЬНЯЯ СТЕНА (Z = -8) - ИСПРАВЛЕНА -->
            <!--<ModelVisual3D>
                <ModelVisual3D.Content>
                    <GeometryModel3D>
                        <GeometryModel3D.Material>
                            <DiffuseMaterial Brush="#9B9B5D"/>
                        </GeometryModel3D.Material>
                        <GeometryModel3D.Geometry>
                            <MeshGeometry3D 
                        Positions="-1.3, 0, -15   -1.5, 1.5, -15   1.5, 0, -15   1.5, 1.5, -15"
                        TriangleIndices="0,1,2  1,3,2" />
                             --><!--ИСПРАВЛЕНИЕ: Раньше дальняя стена была на Z = -1.5 (посередине комнаты).
                         Теперь она на Z = -8, совпадая с полом--><!-- 
                        </GeometryModel3D.Geometry>
                    </GeometryModel3D>
                </ModelVisual3D.Content>
            </ModelVisual3D>-->

            <!-- 8. ПЕРЕДНЯЯ СТЕНА (опционально, Z = 1.5) - если нужно закрыть комнату -->



        </Viewport3D>
    </Grid>
</Window>
