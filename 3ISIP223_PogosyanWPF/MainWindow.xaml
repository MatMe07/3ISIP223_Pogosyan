<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Class="_3ISIP223_PogosyanWPF.MainWindow"
        mc:Ignorable="d"
        Title="MainWindow" MinHeight="480" MinWidth="650" Height="480" Width="800" WindowStartupLocation="CenterScreen">
    <!--<Window.Effect>
        <BlurEffect Radius="4"/>
    </Window.Effect>-->
    <Grid MaxWidth="1100" Margin="0 0">
        <!--<Grid.ColumnDefinitions>
            <ColumnDefinition  Width="auto"/>
            <ColumnDefinition  Width="*"/>
        </Grid.ColumnDefinitions>-->
        
        <TabControl TabStripPlacement="Left">
            <TabControl.Resources>
                <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignTabItem}">
                    <Setter Property="MinWidth" Value="40"/>
                    <Setter Property="MinHeight" Value="40"/>
                    <Setter Property="Padding" Value="8"/>
                </Style>
            </TabControl.Resources>
            <TabItem ToolTip="Каталог книг" >
                <TabItem.Header>
                    <materialDesign:PackIcon Kind="BookMultiple" Width="30" Height="30"/>
                    <!--<Image Source="/Icons/book-bookmark.png"/>-->
                </TabItem.Header>
                <Frame Grid.Column="1" NavigationUIVisibility="Hidden" x:Name="frameCatalog" Source="/Pages/CatalogPage.xaml" Margin="10 0 0 0"/>

            </TabItem>
            <TabItem ToolTip="Списки книг">
                <TabItem.Header>
                    <materialDesign:PackIcon Kind="Bookshelf" Width="30" Height="30"/>

                    <!--<Image Source="/Icons/wishlist.png"/>-->

                </TabItem.Header>
                    <Frame NavigationUIVisibility="Hidden" x:Name="frameListBook" Source="/Pages/ListsPage.xaml" Margin="10 0 0 0"/>
            </TabItem>
            <TabItem ToolTip="Администрирование">
                <TabItem.Header>
                    <!--<Image Source="/Icons/setting.png"/>-->
                    <materialDesign:PackIcon Kind="Administrator" Width="30" Height="30"/>

                </TabItem.Header>
                <Frame  NavigationUIVisibility="Hidden" x:Name="frameAdmin" Source="/Pages/AdminPage.xaml" Margin="10 0 0 0"/>

            </TabItem>
            <TabItem ToolTip="Страница автора">
                <TabItem.Header>
                    <Image Source="/Icons/author.png"/>
                    <!--<materialDesign:PackIcon Kind="TwoFactorAuthentication" Width="30" Height="30"/>-->

                </TabItem.Header>
                <Frame  NavigationUIVisibility="Hidden" Source="/Pages/AuthorPage.xaml" Margin="10 0 0 0"/>

            </TabItem>
            <TabItem ToolTip="Предупреждение о заморозке">
                <TabItem.Header>
                    <!--<Image Source="/Icons/Predupreоdenie.png"/>-->
                    <materialDesign:PackIcon Kind="LockAlert" Width="30" Height="30"/>


                </TabItem.Header>
                <Frame  NavigationUIVisibility="Hidden" Source="/Pages/WarningPage.xaml" Margin="10 0 0 0"/>


            </TabItem>
            <TabItem ToolTip="Профиль">
                <TabItem.Header>
                    <!--<Image Source="/Icons/profile.png"/>-->
                    <materialDesign:PackIcon Kind="AccountCircle" Width="30" Height="30"/>

                </TabItem.Header>
                    <Frame  NavigationUIVisibility="Hidden" x:Name="frameUserAccount" Source="/Pages/ProfilePage.xaml" Margin="10 0 0 0"/>
            </TabItem>
        </TabControl>

    </Grid>
</Window>
