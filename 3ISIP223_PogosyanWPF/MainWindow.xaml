<Window x:Class="_3ISIP223_PogosyanWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="690">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>

        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="10">
            <!--<TextBlock x:Name="TitleTextBlock" Margin="5" VerticalAlignment="Center"/>-->
            <Button x:Name="BackButton" Grid.Row="0" Content="Назад" Width="100"  Margin="5" Click="BackButton_OnClick"/>
            <Button x:Name="ForwardButton" Grid.Row="0" Content="Далее" Width="100"  Margin="5" Click="ForwardButton_OnClick"/>
        </StackPanel>

        <Grid Grid.Column="1" Grid.Row="0" >
            <Image x:Name="CarImage" Source="/Img/BMWRed.png"/>
        </Grid>

        <Frame x:Name="TotalFrame" Grid.Row="0" Grid.Column="0" NavigationUIVisibility="Hidden"  />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="1" Margin="5" Grid.Column="1">
            <!--<TextBlock Text="" Margin="5 5 0 5" FontSize="15"/>-->
            <!--<TextBlock Text="" Margin="5 5 0 5" FontSize="15"/>-->
            <ProgressBar x:Name="progress" Minimum="0" Maximum="5" Width="235" Margin="5" Value="1" />
            <TextBlock x:Name="TotalPrice" HorizontalAlignment="Right" Margin="5" Text="Итого: 0 ₽" FontSize="15"/>
            <!--<TextBlock Margin="0 5 5 5" Text="" FontSize="15"/>-->

        </StackPanel>

    </Grid>
</Window>
