<Window x:Class="_3ISIP223_PogosyanWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF"
        mc:Ignorable="d"
        Title="MainWindow" Height="510" Width="722">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" >
            <StackPanel Orientation="Horizontal">
                <Button Content="Вход" Click="btnSignUpOrIn_Click" Padding="4" FontSize="16" Margin="5"/>
                <Button Content="Регистрация" Click="btnSignUpOrIn_Click" Padding="4" FontSize="16" Margin="5"/>
            </StackPanel>
            <Button Content="Личный кабинет" Visibility="Collapsed" Click="btnPersonalAcc_Click" Padding="4" FontSize="16" Margin="5"/>
        </StackPanel>

        <Frame Margin="5" Grid.Row="1" Source="/Pages/_1MainPage.xaml" />
    </Grid>
</Window>
