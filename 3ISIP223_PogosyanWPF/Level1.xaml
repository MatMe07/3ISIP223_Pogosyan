<Page x:Class="_3ISIP223_PogosyanWPF.Level1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Level1">
    

    <Viewport3D  x:Name="vie">


        <ModelUIElement3D   x:Name="enem" MouseDown="ModelUIElement3D_MouseDown">
            <ModelUIElement3D.Model>
                <GeometryModel3D>
                    <GeometryModel3D.Material>
                        <DiffuseMaterial Brush="Red" />
                    </GeometryModel3D.Material>
                    <GeometryModel3D.Geometry>
                        <MeshGeometry3D
                                Positions="
                                                -0.5, -0.5, -0.5   0.5, -0.5, -0.5   -0.5, 0.5, -0.5   0.5, 0.5, -0.5  
                -0.5, -0.5, 0.5    0.5, -0.5, 0.5    -0.5, 0.5, 0.5    0.5, 0.5, 0.5     
                -0.5, -0.5, -0.5   -0.5, 0.5, -0.5   -0.5, -0.5, 0.5   -0.5, 0.5, 0.5   
                0.5, -0.5, -0.5    0.5, 0.5, -0.5    0.5, -0.5, 0.5    0.5, 0.5, 0.5     
                -0.5, -0.5, -0.5   -0.5, -0.5, 0.5   0.5, -0.5, -0.5   0.5, -0.5, 0.5   
                -0.5, 0.5, -0.5    -0.5, 0.5, 0.5    0.5, 0.5, -0.5    0.5, 0.5, 0.5"    
                                
                                            TriangleIndices="
                0,2,1  1,2,3    
                4,5,6  5,7,6     
                8,10,9 9,10,11   
                12,13,14 13,15,14 
                16,17,18 17,19,18 
                20,21,22 21,23,22 
        "
                                />
                    </GeometryModel3D.Geometry>
                </GeometryModel3D>
            </ModelUIElement3D.Model>
            <ModelUIElement3D.Transform>
                <TranslateTransform3D  OffsetZ="-10" OffsetX="3" />
            </ModelUIElement3D.Transform>
        </ModelUIElement3D>



        <!-- Передняя -->
        <ModelVisual3D>

            <ModelVisual3D.Content>
                <GeometryModel3D>
                    <GeometryModel3D.Material>
                        <DiffuseMaterial Brush="Black"/>
                    </GeometryModel3D.Material>
                    <GeometryModel3D.Geometry>
                        <MeshGeometry3D 
                        Positions="-3, 0, 1.5   -3, 3, 1.5   3, 0, 1.5   3, 3, 1.5"
                        TriangleIndices="1,0,2  1,2,3" />
                    </GeometryModel3D.Geometry>
                </GeometryModel3D>
            </ModelVisual3D.Content>

            <ModelVisual3D.Transform>
                <TranslateTransform3D x:Name="translate"  OffsetZ="-15" OffsetX="2" />
            </ModelVisual3D.Transform>
        </ModelVisual3D>


        <!-- ПОЛ -->
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <GeometryModel3D>
                    <GeometryModel3D.Material>
                        <DiffuseMaterial Brush="#A0A0A0"/>
                    </GeometryModel3D.Material>
                    <GeometryModel3D.Geometry>
                        <MeshGeometry3D 
                        Positions="-10, 0, -15   10, 0, -15   -1.5, 0, 1.5   1.5, 0, 1.5"
                        TriangleIndices="0,2,1  1,2,3" />
                    </GeometryModel3D.Geometry>
                </GeometryModel3D>
            </ModelVisual3D.Content>
        </ModelVisual3D>
        <!-- ПОТОЛОК-->
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <GeometryModel3D>
                    <GeometryModel3D.Material>
                        <DiffuseMaterial Brush="ForestGreen"/>
                    </GeometryModel3D.Material>
                    <GeometryModel3D.Geometry>
                        <MeshGeometry3D 
                        Positions="-10, 1, -15   10, 1, -15   -1.5, 1, 1.5   1.5, 1, 1.5"
                        TriangleIndices="0,1,2 1,3,2" />
                    </GeometryModel3D.Geometry>
                </GeometryModel3D>
            </ModelVisual3D.Content>
        </ModelVisual3D>


        <!-- Левая -->
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <GeometryModel3D>
                    <GeometryModel3D.Material>
                        <DiffuseMaterial Brush="#5D9B9B"/>
                    </GeometryModel3D.Material>
                    <GeometryModel3D.Geometry>
                        <MeshGeometry3D 
                        Positions="1, 0, -15   1, 1.5, -15   -1, 0, 2   -1, 1.5, 1.5"
                        TriangleIndices="0,1,2  1,3,2" />
                    </GeometryModel3D.Geometry>
                </GeometryModel3D>
            </ModelVisual3D.Content>
        </ModelVisual3D>

        <!-- ПРАВАЯ -->
        <ModelVisual3D>
            <ModelVisual3D.Content>
                <GeometryModel3D>
                    <GeometryModel3D.Material>
                        <DiffuseMaterial Brush="#9B5D5D"/>
                    </GeometryModel3D.Material>
                    <GeometryModel3D.Geometry>
                        <MeshGeometry3D 
                        Positions="4.07, 0, -15   4, 1.5, -15   1.5, 0, 1.5   1.25, 1.5, 1.5"
                        TriangleIndices="1,0,2  1,2,3" />
                    </GeometryModel3D.Geometry>
                </GeometryModel3D>
            </ModelVisual3D.Content>
        </ModelVisual3D>



    </Viewport3D>
</Page>
