<Window x:Class="_3ISIP223_PogosyanWPF.Winodws.ProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Winodws"
        mc:Ignorable="d"
        Title="ProductWindow" Height="251" Width="306" WindowStartupLocation="CenterScreen">
    <Grid >

        <Grid.RowDefinitions >
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="ШАМПУНЬ 'ОБЪЕМ'" TextWrapping="Wrap" Grid.Row="0" FontSize="15" Margin="10 0" FontWeight="Bold"/>


        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Производитель: " Grid.Row="0" Grid.Column="0" FontSize="16"/>
            <TextBlock Text="L'Oreal" Grid.Row="0" Grid.Column="1" FontSize="16"/>

            <TextBlock Text="Тип товара: " Grid.Row="1" Grid.Column="0" FontSize="16"/>
            <TextBlock Text="Шампунь" Grid.Row="1" Grid.Column="1" FontSize="16"/>

            <TextBlock Text="Рейтинг: " Grid.Row="2" Grid.Column="0" FontSize="16"/>
            <TextBlock Text="⭐ 4.2" Grid.Row="2" Grid.Column="1" FontSize="16"/>

            <TextBlock Text="Цена: " Grid.Row="3" Grid.Column="0" FontSize="16" VerticalAlignment="Center"/>
            <Border Grid.Row="3" Grid.Column="1" Background="LightPink" Padding="5" HorizontalAlignment="Left" CornerRadius="7" Margin="5">
                <TextBlock Text="1 200 ₽" FontSize="16" FontWeight="Medium"/>
            </Border>

            <TextBlock Text="Описание: " Grid.Row="4" Grid.Column="0" FontSize="16"/>
            <TextBlock Text="Объемный шампунь для тонких волос" TextWrapping="Wrap" Grid.Row="4" Grid.Column="1" Width="165" FontSize="16" HorizontalAlignment="Left"/>

        </Grid>

        <Button Content="Добавить в корзину" Grid.Row="3" Margin="5" HorizontalAlignment="Center"/>
    </Grid>
</Window>
