<Window x:Class="_3ISIP223_PogosyanWPF.Winodws.DatailAppointment"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Winodws"
        mc:Ignorable="d"
        Title="DatailAppointment" Height="257" Width="325">
    <Grid >

        <Grid.RowDefinitions >
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        
        
        <TextBlock Text="Информация о записи" TextWrapping="Wrap" Grid.Row="0" FontSize="15" Margin="10 0" FontWeight="Bold"/>


        <Grid Grid.Row="2" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="ФИО: " Grid.Row="0" Grid.Column="0" FontSize="16" Margin="0 4"/>
            <TextBlock Text="Погосян Эдик" Grid.Row="0" Grid.Column="1" FontSize="16" Margin="0 4"/>

            <TextBlock Text="Услуга: " Grid.Row="1" Grid.Column="0" FontSize="16" Margin="0 4"/>
            <TextBlock Text="МАНИКЮР" Grid.Row="1" Grid.Column="1" FontSize="16" Margin="0 4"/>

            <TextBlock Text="Телефон: " Grid.Row="2" Grid.Column="0" FontSize="16" Margin="0 4 10 0"/>
            <TextBlock Text="+7 9019030419" Grid.Row="2" Grid.Column="1" FontSize="16" Margin="0 4"/>

            <TextBlock Text="Дата: " Grid.Row="3" Grid.Column="0" FontSize="16" Margin="0 4"/>
            <TextBlock Text="15 АПРЕЛЯ 2026 г." Grid.Row="3" Grid.Column="1" FontSize="16" Margin="0 4"/>

            <TextBlock Text="Время: " Grid.Row="4" Grid.Column="0" FontSize="16" Margin="0 4"/>
            <TextBlock Text="10:00"  Grid.Row="4" Grid.Column="1"  FontSize="16" HorizontalAlignment="Left" Margin="0 4"/>

        </Grid>

        <Grid Grid.Row="3" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Grid.Column="0"  Style="{StaticResource SecondaryButton}"  Margin="5"/>
            <Button Content="Завершить запись" Grid.Column="1"  Margin="5" Style="{StaticResource ConfirmButton}"/>
        </Grid>
    </Grid>
</Window>
