<Window x:Class="_3ISIP223_PogosyanWPF.Winodws.Admin.FrozenUserWIndow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Winodws.Admin"
        mc:Ignorable="d"
        Title="FrozenUserWIndow" Height="240" Width="452">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Заморозка пользователя" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0 10"/>


        <StackPanel Grid.Row="1" Margin="10 10" HorizontalAlignment="Left">
            <TextBlock Text="Пользователь" FontSize="14" Margin="0 5"/>
            <TextBlock Text="Иванова Анна Сергеевна" FontSize="16" FontWeight="Bold" Foreground="#333"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10 5" HorizontalAlignment="Left">
            <TextBlock Text="Текущая роль" FontSize="14" Margin="0 5"/>
            <TextBlock Text="КЛИЕНТ" FontSize="14" FontWeight="Bold" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0 15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Grid.Column="0" Margin="10 0"  Style="{StaticResource SecondaryButton}"/>
            <Button Content="Заморозить" Grid.Column="1" Margin="10 0" Style="{StaticResource FreezeButton}"/>
            <Button Content="Разморозить" Grid.Column="1" Margin="10 0" Background="Transparent" Style="{StaticResource UnfreezeButton}"/>
            <Button Content="Удалить" Grid.Column="1" Margin="10 0" Background="Transparent" Style="{StaticResource DeleteButton}"/>
        </Grid>
    </Grid>
</Window>
