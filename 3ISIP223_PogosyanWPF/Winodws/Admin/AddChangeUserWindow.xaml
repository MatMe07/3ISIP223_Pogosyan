<Window x:Class="_3ISIP223_PogosyanWPF.Winodws.Admin.AddUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Winodws.Admin"
        mc:Ignorable="d"
        Title="AddUserWindow" Height="333" Width="276">

    <Grid>
        <ScrollViewer>
            <Grid >
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Редактирование пользователя" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0 10"/>

                <TextBlock Text="Добавление пользователя" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0 10"/>

                <StackPanel Grid.Row="1" Margin="10 5" HorizontalAlignment="Left">
                    <TextBlock Text="Фамилия" FontSize="14" Margin="0 5"/>
                    <TextBox Width="200" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="10 5" HorizontalAlignment="Left">
                    <TextBlock Text="Имя" FontSize="14" Margin="0 5"/>
                    <TextBox Width="200" />
                </StackPanel>

                <StackPanel Grid.Row="3" Margin="10 5" HorizontalAlignment="Left">
                    <TextBlock Text="Отчество" FontSize="14" Margin="0 5"/>
                    <TextBox Width="200" />
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="10 5" HorizontalAlignment="Left">
                    <TextBlock Text="Телефон" FontSize="14" Margin="0 5"/>
                    <TextBox Width="200" />
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="10 5" HorizontalAlignment="Left">
                    <TextBlock Text="Email" FontSize="14" Margin="0 5"/>
                    <TextBox Width="200" />
                </StackPanel>

                <StackPanel Grid.Row="6" Margin="10 5" HorizontalAlignment="Left">
                    <TextBlock Text="Роль" FontSize="14" Margin="0 5"/>
                    <ComboBox Width="150">
                        <ComboBoxItem Content="Клиент" IsSelected="True"/>
                        <ComboBoxItem Content="Мастер"/>
                        <ComboBoxItem Content="Менеджер"/>
                        <ComboBoxItem Content="Администратор"/>
                    </ComboBox>
                </StackPanel>


                <StackPanel Grid.Row="9" Margin="10 5 10 15" HorizontalAlignment="Left">
                    <CheckBox Content="Активен" IsChecked="True" FontSize="14"/>
                </StackPanel>

            </Grid>

        </ScrollViewer>
        <Grid VerticalAlignment="Bottom" Background="White" >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Назад"  Style="{StaticResource SecondaryButton}" Grid.Column="0" HorizontalAlignment="Center"/>
            <Button Content="Добавить" Grid.Column="1"  HorizontalAlignment="Center" Style="{StaticResource AddButton}"/>
            <Button Content="Сохранить" Background="Transparent" Grid.Column="1" HorizontalAlignment="Center" Style="{StaticResource ConfirmButton}"/>
        </Grid>

    </Grid>
</Window>
