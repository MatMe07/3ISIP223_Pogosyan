<Window x:Class="_3ISIP223_PogosyanWPF.Winodws.AddEditUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Добавление пользователя" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Фамилия:"/>
        <TextBox x:Name="txtLastName" Grid.Row="2" Margin="0,5,0,15"/>

        <TextBlock Grid.Row="3" Text="Имя:"/>
        <TextBox x:Name="txtFirstName" Grid.Row="4" Margin="0,5,0,15"/>

        <TextBlock Grid.Row="5" Text="Отчество:"/>
        <TextBox x:Name="txtSecondName" Grid.Row="6" Margin="0,5,0,15"/>

        <TextBlock Grid.Row="7" Text="Телефон:"/>
        <TextBox x:Name="txtPhone" Grid.Row="8" Margin="0,5,0,15"/>

        <TextBlock Grid.Row="9" Text="Email:"/>
        <TextBox x:Name="txtEmail" Grid.Row="10" Margin="0,5,0,15"/>

        <TextBlock Grid.Row="11" Text="Роль:"/>
        <ComboBox x:Name="cmbRole" Grid.Row="12" Margin="0,5,0,15"
                  SelectedValuePath="TypeRole_ID"/>

        <Grid Grid.Row="13" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Grid.Column="0" Margin="5" 
                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            <Button Content="Сохранить" Grid.Column="1" Margin="5" 
                    Style="{StaticResource ConfirmButton}" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>