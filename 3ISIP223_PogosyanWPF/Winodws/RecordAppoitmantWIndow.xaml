<Window x:Class="_3ISIP223_PogosyanWPF.RecordAppoitmantWIndow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF"
        mc:Ignorable="d"
        Title="RecordAppoitmantWIndow" Height="474" Width="377">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="ПОДТВЕРЖДЕНИЕ ЗАПИСИ" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text="ИНФОРМАЦИЯ О ЗАПИСИ" Grid.Row="1" Margin="10 10 10 0" FontSize="14" FontWeight="Medium"/>
        <Grid Grid.Row="2" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="Тип услуги: "  Grid.Row="0" Grid.Column="0" FontSize="16" Margin="0 5 10 5"/>
            <TextBlock Text="МАНИКЮР" Grid.Row="0" Grid.Column="1" FontSize="16" VerticalAlignment="Center"/>

            <TextBlock Text="Мастер: " Grid.Row="1" Grid.Column="0" FontSize="16" Margin="0 5 10 5"/>
            <TextBlock Text="АННА КУЗНЕЦОВА" Grid.Row="1" Grid.Column="1" FontSize="16" VerticalAlignment="Center"/>

            <TextBlock Text="Дата: " Grid.Row="2" Grid.Column="0" FontSize="16" Margin="0 5 10 5"/>
            <TextBlock Text="15 АПРЕЛЯ 2026 г." Grid.Row="2" Grid.Column="1" FontSize="16" VerticalAlignment="Center"/>

            <TextBlock Text="Время: " Grid.Row="3" Grid.Column="0" FontSize="16" Margin="0 5 10 5"/>
            <TextBlock Text="10:00" Grid.Row="3" Grid.Column="1" FontSize="16" VerticalAlignment="Center"/>

            <TextBlock Text="Цена: " Grid.Row="4" Grid.Column="0" FontSize="16" Margin="0 5 10 5"/>
            <TextBlock Text="1 500 ₽" Grid.Row="4" Grid.Column="1" FontSize="16" VerticalAlignment="Center"/>

        </Grid>
        
        <GroupBox Header="СПОСОБ ОПЛАТЫ" Grid.Row="3" Margin="10" FontSize="14" FontWeight="Medium">
            <StackPanel>
                <RadioButton GroupName="0" Content="Наличные" Margin="10 5 10 5"/>
                <RadioButton GroupName="0" Content="Банковская карта" Margin="10 5 10 5"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Text="КОММЕНТАРИЙ (не обязательно)"  Grid.Row="4" Margin="10" FontSize="14" FontWeight="Medium"/>
        <RichTextBox Grid.Row="5" Height="49" Margin="10 0 10 0"  FontSize="14"/>
        <Grid Margin="0 10" Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Grid.Column="0" Margin="10 0"  Style="{StaticResource SecondaryButton}"/>
            <Button Content="Записаться" Grid.Column="1" Margin="10 0" Style="{StaticResource ConfirmButton}"/>

        </Grid>
    </Grid>
</Window>
