<Window x:Class="_3ISIP223_PogosyanWPF.RecordAppoitmantWIndow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF"
        mc:Ignorable="d"
        Title="RecordAppoitmantWIndow" Height="474" Width="377"
        WindowStartupLocation="CenterOwner">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="ПОДТВЕРЖДЕНИЕ ЗАПИСИ" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
        <TextBlock Text="ИНФОРМАЦИЯ О ЗАПИСИ" Grid.Row="1" Margin="10 10 10 0" FontSize="14" FontWeight="Medium"/>

        <Grid x:Name="InfoGrid" Grid.Row="2" Margin="10 0 10 10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Тип услуги: " Grid.Row="0" Grid.Column="0" FontSize="16" Margin="0 5 10 5"/>
            <TextBlock x:Name="txtServiceType" Grid.Row="0" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Text="—"/>

            <TextBlock Text="Мастер: " Grid.Row="1" Grid.Column="0" FontSize="16" Margin="0 5 10 5"/>
            <TextBlock x:Name="txtMaster" Grid.Row="1" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Text="—"/>

            <TextBlock Text="Дата: " Grid.Row="2" Grid.Column="0" FontSize="16" Margin="0 5 10 5"/>
            <TextBlock x:Name="txtDate" Grid.Row="2" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Text="—"/>

            <TextBlock Text="Время: " Grid.Row="3" Grid.Column="0" FontSize="16" Margin="0 5 10 5"/>
            <TextBlock x:Name="txtTime" Grid.Row="3" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Text="—"/>

            <TextBlock Text="Цена: " Grid.Row="4" Grid.Column="0" FontSize="16" Margin="0 5 10 5"/>
            <TextBlock x:Name="txtPrice" Grid.Row="4" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Text="—"/>
        </Grid>

        <GroupBox Header="СПОСОБ ОПЛАТЫ" Grid.Row="3" Margin="10" FontSize="14" FontWeight="Medium">
            <StackPanel>
                <RadioButton x:Name="rbCash" GroupName="PaymentMethod" Content="Наличные" Margin="10 5 10 5" IsChecked="True"/>
                <RadioButton x:Name="rbCard" GroupName="PaymentMethod" Content="Банковская карта" Margin="10 5 10 5"/>
            </StackPanel>
        </GroupBox>

        <TextBlock Text="КОММЕНТАРИЙ (не обязательно)" Grid.Row="4" Margin="10" FontSize="14" FontWeight="Medium"/>
        <RichTextBox x:Name="txtComment" Grid.Row="5" Height="49" Margin="10 0 10 0" FontSize="14"/>

        <Grid Margin="0 10" Grid.Row="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Grid.Column="0" Margin="10 0" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            <Button Content="Записаться" Grid.Column="1" Margin="10 0" Style="{StaticResource ConfirmButton}" Click="Confirm_Click"/>
        </Grid>
    </Grid>
</Window>