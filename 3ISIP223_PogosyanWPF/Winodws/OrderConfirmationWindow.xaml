<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    mc:Ignorable="av" 
    x:Class="_3ISIP223_PogosyanWPF.Winodws.OrderConfirmationWindow"
        Title="Оформление заказа" Height="500" Width="450"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF"
        
    d:Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="ОФОРМЛЕНИЕ ЗАКАЗА" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="5" Padding="10" Margin="0,5">
                <StackPanel>
                    <TextBlock Text="📦 СОСТАВ ЗАКАЗА" FontWeight="Bold" Margin="0,0,0,10"/>
                    <ListBox x:Name="lstOrderItems" Height="150" BorderBrush="{x:Null}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Margin="0,3">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="{}{0} x{1} = {2:F2} ₽">
                                            <Binding Path="Product.Name"/>
                                            <Binding Path="Quantity"/>
                                            <Binding Path="TotalPrice"/>
                                        </MultiBinding>
                                    </TextBlock.Text>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="Black"/>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="txtTotalAmount" FontWeight="Bold" Margin="0,10,0,0" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
            

            <TextBlock Grid.Row="2" Text="📅 ДАТА ПОЛУЧЕНИЯ" FontWeight="Bold" Margin="0,15,0,5"/>
            <TextBlock Grid.Row="3" Text="(не более 7 дней от сегодня)" FontSize="12" Foreground="Gray" Margin="0,0,0,5"/>

            <ListBox x:Name="lstDeliveryDates" Grid.Row="4" Height="120" Margin="0,5,0,15"
                 SelectionChanged="DeliveryDate_SelectionChanged" av:ItemsSource="{av:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="5">
                            <RadioButton GroupName="DeliveryDate" 
                                     Content="{Binding Date, StringFormat=dddd\, dd MMMM yyyy}"
                                     IsChecked="{Binding IsSelected}"
                                     Margin="5"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="5" Text="💳 СПОСОБ ОПЛАТЫ" FontWeight="Bold" Margin="0,0,0,5"/>
            <StackPanel Grid.Row="6" Margin="0,0,0,20">
                <RadioButton x:Name="rbCash" GroupName="PaymentMethod" Content="Наличные при получении" 
                         Margin="10,5" IsChecked="True" Checked="PaymentMethod_Checked"/>
                <RadioButton x:Name="rbCard" GroupName="PaymentMethod" Content="Банковская карта при получении" 
                         Margin="10,5" Checked="PaymentMethod_Checked"/>
                <RadioButton x:Name="rbOnline" GroupName="PaymentMethod" Content="Онлайн на сайте" 
                         Margin="10,5" Checked="PaymentMethod_Checked"/>
            </StackPanel>

            <Grid Grid.Row="7" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Отмена" Grid.Column="0" Margin="5" 
                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button x:Name="btnConfirm" Content="Подтвердить заказ" Grid.Column="1" Margin="5" 
                    Style="{StaticResource ConfirmButton}" IsEnabled="False" Click="Confirm_Click"/>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>