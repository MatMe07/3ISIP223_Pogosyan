<Window x:Class="_3ISIP223_PogosyanWPF.Winodws.AddEditProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Товар" Height="500" Width="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Добавление товара" FontSize="18" FontWeight="Bold" 
                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="Название:"/>
        <TextBox x:Name="txtName" Grid.Row="2" Margin="0,5,0,15"/>

        <TextBlock Grid.Row="3" Text="Цена:"/>
        <TextBox x:Name="txtPrice" Grid.Row="4" Margin="0,5,0,15"/>

        <TextBlock Grid.Row="5" Text="Скидка (%):"/>
        <TextBox x:Name="txtDiscount" Grid.Row="6" Margin="0,5,0,15"/>

        <TextBlock Grid.Row="7" Text="Рейтинг:"/>
        <TextBox x:Name="txtRating" Grid.Row="8" Margin="0,5,0,15"/>

        <TextBlock Grid.Row="9" Text="Тип товара:"/>
        <ComboBox x:Name="cmbProductType" Grid.Row="10" Margin="0,5,0,15"
                  DisplayMemberPath="Name" SelectedValuePath="ProductType_ID"/>

        <TextBlock Grid.Row="11" Text="Производитель:"/>
        <ComboBox x:Name="cmbManufacturer" Grid.Row="12" Margin="0,5,0,15"
                  DisplayMemberPath="Name" SelectedValuePath="Manufacturer_ID"/>

        <Grid Grid.Row="13" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Content="Отмена" Grid.Column="0" Margin="5" 
                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            <Button Content="Сохранить" Grid.Column="1" Margin="5" 
                    Style="{StaticResource ConfirmButton}" Click="Save_Click"/>
        </Grid>
    </Grid>
</Window>