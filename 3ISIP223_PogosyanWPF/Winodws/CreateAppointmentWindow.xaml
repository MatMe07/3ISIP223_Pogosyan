<Window x:Class="_3ISIP223_PogosyanWPF.Winodws.CreateAppointmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF"
        mc:Ignorable="d"
        Title="Создание записи" Height="550" Width="450" d:Height="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <ScrollViewer ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="СОЗДАНИЕ ЗАПИСИ" HorizontalAlignment="Center" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" Margin="0 10"/>

            <TextBlock Text="ИНФОРМАЦИЯ О ЗАПИСИ" Grid.Row="1" Margin="10 10 10 0" FontSize="14" FontWeight="Medium"/>

            <Grid Grid.Row="2" Margin="10 0 10 10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Клиент: " Grid.Row="0" Grid.Column="0" FontSize="16" Margin="0 5 10 5" VerticalAlignment="Center"/>
                <TextBlock x:Name="cmbClient" Text="Клиент: " Grid.Row="0" Grid.Column="1" FontSize="16" Margin="0 5 10 5" VerticalAlignment="Center"/>
               
                
                <TextBlock Text="Тип услуги: " Grid.Row="1" Grid.Column="0" FontSize="16" Margin="0 5 10 5" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbServiceType" Grid.Row="1" Grid.Column="1" FontSize="14"
                      DisplayMemberPath="Name" SelectedValuePath="TypeID"
                      SelectionChanged="CmbServiceType_SelectionChanged"
                      Margin="0 5 0 5"/>

                <TextBlock Text="Мастер: " Grid.Row="2" Grid.Column="0" FontSize="16" Margin="0 5 10 5" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbMaster" Grid.Row="2" Grid.Column="1" FontSize="14"
                      DisplayMemberPath="FIO" SelectedValuePath="User_ID"
                      SelectionChanged="CmbMaster_SelectionChanged"
                      Margin="0 5 0 5"/>

                <TextBlock Text="Дата: " Grid.Row="3" Grid.Column="0" FontSize="16" Margin="0 5 10 5" VerticalAlignment="Center"/>
                <DatePicker x:Name="dpDate" Grid.Row="3" Grid.Column="1" 
                        SelectedDateChanged="DpDate_SelectedDateChanged"
                        Margin="0 5 0 5"/>

                <TextBlock Text="Время: " Grid.Row="4" Grid.Column="0" FontSize="16" Margin="0 5 10 5" VerticalAlignment="Center"/>
                <ComboBox x:Name="cmbTime" Grid.Row="4" Grid.Column="1" FontSize="14"
                      IsEditable="True" SelectedIndex="-1"
                      Margin="0 5 0 5"/>

                <TextBlock Text="Цена: " Grid.Row="5" Grid.Column="0" FontSize="16" Margin="0 5 10 5" VerticalAlignment="Center"/>
                <TextBlock x:Name="txtPrice" Grid.Row="5" Grid.Column="1" FontSize="16" VerticalAlignment="Center" Text="—"/>

                <TextBlock Text="Доступные слоты: " Grid.Row="6" Grid.Column="0" FontSize="16" Margin="0 5 10 5" VerticalAlignment="Center"/>
                <ListBox x:Name="lstAvailableSlots" Grid.Row="6" Grid.Column="1" Height="80"
                     SelectionChanged="LstAvailableSlots_SelectionChanged"
                     Margin="0 5 0 5" d:ItemsSource="{d:SampleData ItemCount=5}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="13"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GroupBox Header="СПОСОБ ОПЛАТЫ" Grid.Row="3" Margin="10" FontSize="14" FontWeight="Medium">
                <StackPanel>
                    <RadioButton x:Name="rbCash" GroupName="PaymentMethod" Content="Наличные" Margin="10 5 10 5" IsChecked="True"/>
                    <RadioButton x:Name="rbCard" GroupName="PaymentMethod" Content="Банковская карта" Margin="10 5 10 5"/>
                </StackPanel>
            </GroupBox>

            <TextBlock Text="КОММЕНТАРИЙ (не обязательно)" Grid.Row="4" Margin="10" FontSize="14" FontWeight="Medium"/>
            <TextBox x:Name="txtComment" Grid.Row="5" Height="49" Margin="10 0 10 0" FontSize="14" TextWrapping="Wrap" AcceptsReturn="True"/>

            <Grid Margin="10 10" Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Отмена" Grid.Column="0" Margin="10 0" Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                <Button Content="Создать запись" Grid.Column="1" Margin="10 0" Style="{StaticResource ConfirmButton}" Click="Save_Click"/>
            </Grid>
        </Grid>

    </ScrollViewer>
</Window>