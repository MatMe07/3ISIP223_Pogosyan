<Window x:Class="_3ISIP223_PogosyanWPF.Windows.LoginRegisterWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels"
        mc:Ignorable="d"
        Title="LoginRegisterWindows"
        Height="500" Width="450" 
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}">
    <Window.DataContext>
        <local:LoginRegisterViewModel/>
    </Window.DataContext>
    <Grid>
        <TabControl Background="Transparent" x:Name="tabControlMain">

            <TabItem Header="ВХОД" x:Name="item1"  FontSize="14">
                <Grid Margin="30">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Вход в аккаунт" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               HorizontalAlignment="Center" 
                               Margin="0 0 0 30" />

                    <TextBlock Grid.Row="1"   Text="Логин"  FontWeight="Medium"  FontSize="14" Margin="0 0 0 5"/>

                    <TextBox Grid.Row="2"  Margin="0 0 0 20" 
                             Padding="12 10"   materialDesign:HintAssist.Hint="Введите логин"
                             Style="{StaticResource  MaterialDesignTextBoxBase}"
                             FontSize="14"
                             Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="3"  Text="Пароль" 
                               FontWeight="Medium"  FontSize="14" Margin="0 0 0 5"/>

                    <PasswordBox Grid.Row="4" 
                                 Margin="0 0 0 25"  Padding="12 10"  x:Name="passWordLog"
                                 materialDesign:HintAssist.Hint="Введите пароль" 
                                 Style="{StaticResource  MaterialDesignRevealPasswordBox}"
                                 FontSize="14">
                    </PasswordBox>

                    <Button Content="ВОЙТИ" 
                            Grid.Row="5"  Style="{StaticResource MaterialDesignRaisedButton}"
                            Foreground="White" FontWeight="Bold" FontSize="14"
                            Click="Login_Click"
                            Cursor="Hand"/>
                </Grid>
            </TabItem>

            <TabItem Header="РЕГИСТРАЦИЯ" x:Name="item2"  FontSize="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="30">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Регистрация" 
                                   FontSize="24"  FontWeight="Bold"  HorizontalAlignment="Center" 
                                   Margin="0 0 0 30"/>

                        <TextBlock Grid.Row="1" 
                                   Text="Логин"  FontWeight="Medium" 
                                   FontSize="14" Margin="0 0 0 5"/>

                        <TextBox Grid.Row="2"  Margin="0 0 0 20" 
                                 Padding="12 10"  materialDesign:HintAssist.Hint="Придумайте логин"
                                 Style="{StaticResource MaterialDesignTextBoxBase}"
                                 FontSize="14" materialDesign:HintAssist.HelperTextFontSize="13"
                                 Text="{Binding RegLogin, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="3"  Text="Отображаемое имя" 
                                   FontWeight="Medium" 
                                   FontSize="14" Margin="0 0 0 5"/>

                        <TextBox Grid.Row="4" 
                                 Margin="0 0 0 20"  Padding="12 10"  materialDesign:HintAssist.Hint="Как вас называть"
                                 Style="{StaticResource MaterialDesignTextBoxBase}"
                                 FontSize="14"
                                 Text="{Binding RegDisplayName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="5" 
                                   Text="Email"  FontWeight="Medium"  FontSize="14"
                                   Margin="0 0 0 5"/>

                        <TextBox Grid.Row="6"  Margin="0 0 0 20"  Padding="12 10" 
                                 materialDesign:HintAssist.Hint="example@mail.com" Style="{StaticResource MaterialDesignTextBoxBase}"
                                 FontSize="14"
                                 Text="{Binding RegEmail, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Grid.Row="7" 
                                   Text="Пароль"  FontWeight="Medium"   FontSize="14"
                                   Margin="0 0 0 5"/>

                        <PasswordBox Grid.Row="8"  Margin="0 0 0 20"  x:Name="passWordReg"  Padding="12 10"  materialDesign:HintAssist.Hint="Придумайте пароль"
                                     Style="{StaticResource  MaterialDesignRevealPasswordBox}"
                                     FontSize="14">
                        </PasswordBox>

                        <TextBlock Grid.Row="9" 
                                   Text="Подтверждение пароля"  FontWeight="Medium"  FontSize="14"
                                   Margin="0 0 0 5"/>

                        <PasswordBox Grid.Row="10"  Margin="0 0 0 30" x:Name="passWordRegRep"  Padding="12 10"  materialDesign:HintAssist.Hint="Повторите пароль"
                                     Style="{StaticResource  MaterialDesignRevealPasswordBox}"
                                     FontSize="14">
                        </PasswordBox>

                        <Button Content="ЗАРЕГИСТРИРОВАТЬСЯ"  Grid.Row="11" Style="{StaticResource MaterialDesignRaisedButton}"
                                Foreground="White" FontWeight="Bold" FontSize="14"  Click="Register_Click"
                                Cursor="Hand"/>

                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <materialDesign:Snackbar x:Name="MySnackbar"
                                 MessageQueue="{Binding MyMessageQueue}" Foreground="White"
                                 HorizontalAlignment="Stretch"
                                 VerticalAlignment="Bottom"
                                 Margin="10"/>
    </Grid>
</Window>