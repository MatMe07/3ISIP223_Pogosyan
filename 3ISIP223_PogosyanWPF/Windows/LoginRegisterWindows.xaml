<Window x:Class="_3ISIP223_PogosyanWPF.Windows.LoginRegisterWindows"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Windows"
        mc:Ignorable="d"
        Title="LoginRegisterWindows"
        Height="500" Width="450" d:Height="1000">

    <Grid>
        <TabControl>
            <TabItem Header="🔐 Вход">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Вход в аккаунт" FontSize="20" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,20" />

                    <TextBlock Grid.Row="1" Text="Логин" FontWeight="Medium" FontSize="16"/>
                    <TextBox x:Name="txtLogin" Grid.Row="2" Margin="0,0,0,20" Padding="8" materialDesign:HintAssist.Hint="Введите логин"/>

                    <TextBlock Grid.Row="3" Text="Пароль" FontWeight="Medium" FontSize="16"/>
                    <PasswordBox x:Name="txtPassword" Grid.Row="4" Margin="0,0,0,20" Padding="8" materialDesign:HintAssist.Hint="Введите пароль" />

                    <Button Content="Войти" Grid.Row="5"
                                 Click="Login_Click"/>
                </Grid>
            </TabItem>
            <TabItem Header="📝 Регистрация">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Регистрация" FontSize="20" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Grid.Row="1" Text="Логин" FontWeight="Medium" FontSize="16"/>
                        <TextBox x:Name="txtRegLogin" Grid.Row="2" Margin="0,0,0,20" Padding="8" materialDesign:HintAssist.Hint="Введите логин"/>

                        <TextBlock Grid.Row="3" Text="Отображаемое имя" FontWeight="Medium" FontSize="16"/>
                        <TextBox x:Name="txtRegFirstName" Grid.Row="4" Margin="0,0,0,20" Padding="8" materialDesign:HintAssist.Hint="Введите имя"/>

                        <TextBlock Grid.Row="5" Text="Email" FontWeight="Medium" FontSize="16"/>
                        <TextBox x:Name="txtRegEmail" Grid.Row="6" Margin="0,0,0,20" Padding="8" materialDesign:HintAssist.Hint="Введите email"/>

                        <TextBlock Grid.Row="7" Text="Пароль" FontWeight="Medium" FontSize="16"/>
                        <PasswordBox x:Name="txtRegPassword" Grid.Row="8" Margin="0,0,0,20" Padding="8" materialDesign:HintAssist.Hint="Введите пароль"/>

                        <TextBlock Grid.Row="9" Text="Подтверждение пароля" FontWeight="Medium" FontSize="16"/>
                        <PasswordBox x:Name="txtRegConfirmPassword" Grid.Row="10" Margin="0,5,0,20" Padding="8" materialDesign:HintAssist.Hint="Подтвердите пароль"/>

                        <Button Content="Зарегистрироваться" Grid.Row="11" Margin="5" 
                                     Click="Register_Click"/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

    </Grid>
</Window>