<Window x:Class="_3ISIP223_PogosyanWPF.Windows.AddReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterOwner"
        
        mc:Ignorable="d"
        Title="Оставить отзыв" Height="364" Width="534" MinHeight="364" MinWidth="534" Background="#FFF4F4FC" >

    <Window.DataContext>
        <local:AddReviewViewModel/>
    </Window.DataContext>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal">
            <Border CornerRadius="15" Width="30" Height="30" >
                <Border.Background>
                    <ImageBrush ImageSource="/NoneUserPath.png"/>
                </Border.Background>
            </Border>
            <TextBlock Text="{Binding UserName}" VerticalAlignment="Center" Margin="5 0" FontWeight="Black" FontSize="15"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 10">
            <TextBlock Text="Ваша оценка" VerticalAlignment="Center" FontFamily="Tahoma" FontSize="14"/>
            <materialDesign:RatingBar Margin="10 2" Value="{Binding SelectRatingReview, Mode=TwoWay}">
                <materialDesign:RatingBar.LayoutTransform >
                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"></ScaleTransform>
                </materialDesign:RatingBar.LayoutTransform>
            </materialDesign:RatingBar>
        </StackPanel>
        <RichTextBox Visibility="Collapsed"
                     Style="{StaticResource MaterialDesignOutlinedRichTextBox}" 
                     
                     DataContext="{Binding EditorTextRange, Mode=TwoWay}"
                     VerticalContentAlignment="Top" Padding="10" ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="80" MaxHeight="150"
                     materialDesign:HintAssist.Hint="Что думаете о книге?" Background="White" BorderBrush="#FFE2E4EA" >
            <FlowDocument>
                <Block.LineHeight >
                    1
                </Block.LineHeight>
                
            </FlowDocument>
        </RichTextBox>

        <TextBox Grid.Row="2"
                 Margin="0 5" materialDesign:HintAssist.Hint="Что думаете о книге?" Style="{StaticResource  MaterialDesignOutlinedTextBox}" 
                 Padding="7 3"
                 Text="{Binding EditorText}"
                 MinHeight="70" MaxHeight="140" VerticalScrollBarVisibility="Auto" AcceptsReturn="True">
            
        </TextBox>
        
        <TextBlock Text="Поставьте оценку и напишите отзыв" Grid.Row="3" Margin="15 0" FontSize="12" FontWeight="Medium" Foreground="#FF9D9C9F" />

        <Button Content="Опубликовать"  Grid.Row="4" HorizontalAlignment="Left" FontSize="14" Margin="0 15" Click="btnPublish_Click"/>
    </Grid>
</Window>
