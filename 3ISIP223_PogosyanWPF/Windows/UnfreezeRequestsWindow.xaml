<Window x:Class="_3ISIP223_PogosyanWPF.Windows.UnfreezeRequestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Windows"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterOwner"
        
        mc:Ignorable="d"
        Title="Оставить отзыв" MinHeight="285" MinWidth="422" Height="285" Width="422" Background="#FFF4F4FC" >
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Объясните причину, почему стоит разморозить аккаунт" Grid.Row="1"  
                   Margin="0 10" VerticalAlignment="Center" FontFamily="Tahoma" FontSize="14"/>

        <RichTextBox Grid.Row="2" Margin="0 5" 
                     Style="{StaticResource MaterialDesignOutlinedRichTextBox}" x:Name="richTextsUnfreeze"
                     VerticalContentAlignment="Top" Padding="10" ScrollViewer.VerticalScrollBarVisibility="Auto" MinHeight="80" MaxHeight="120"
                     materialDesign:HintAssist.Hint="Текст причины оспаривания..." Background="White" BorderBrush="#FFE2E4EA"  TextChanged="richTextsUnfreeze_TextChanged" >
            <FlowDocument>
                <Block.LineHeight >
                    1
                </Block.LineHeight>
            </FlowDocument>
        </RichTextBox>
        <TextBlock Text="{Binding LengthUnfreezeText, StringFormat='\{0}/20'}" Grid.Row="3" Margin="15 0" FontSize="10" FontWeight="Medium" Foreground="#FF9D9C9F" HorizontalAlignment="Right" />

        <StackPanel Grid.Row="4" Margin="0 15" Orientation="Horizontal">
            <Button Content="Отмена" BorderBrush="Transparent"  HorizontalAlignment="Left" FontSize="14"  Style="{StaticResource MaterialDesignFlatLightBgButton}" Click="btnCancel_Click" />
            <Button Content="Отправить"  HorizontalAlignment="Left" FontSize="14" Margin="20 0" />

        </StackPanel>
    </Grid>
</Window>