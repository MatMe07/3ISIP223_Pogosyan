<Window x:Class="_3ISIP223_PogosyanWPF.Windows.FreezeRequestPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="Подать жалобу" MinHeight="250" MinWidth="450" Height="250" Width="450" Background="#FFF4F4FC" >
    <Window.DataContext>
        <local:FreezeRequestViewModel/>
    </Window.DataContext>
    
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="{Binding AboutTitle}" Grid.Row="0"  
                   Margin="0 10" VerticalAlignment="Center" FontFamily="Tahoma" FontSize="14"/>

        <ComboBox Grid.Row="1"  ItemsSource="{Binding ReasonLst}" DisplayMemberPath="Name" materialDesign:HintAssist.Hint="Причина" SelectedValuePath="Name" SelectedItem="{Binding SelReason}" MinWidth="150" VerticalAlignment="Center"  FontSize="15"/>

        <StackPanel Grid.Row="4" Margin="0 15" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Content="Отмена" BorderBrush="Transparent"  HorizontalAlignment="Left" FontSize="14"  Style="{StaticResource MaterialDesignFlatLightBgButton}" Click="btnCancel_Click" />
            <Button Content="Отправить"  HorizontalAlignment="Left" FontSize="14" Margin="20 0" Click="btnSend_Click" />

        </StackPanel>
        <materialDesign:Snackbar x:Name="MySnackbar" Margin="-15"  MessageQueue="{Binding MyMessageQueue}"  Foreground="White"  HorizontalAlignment="Right" Grid.RowSpan="6" VerticalAlignment="Top"/>

    </Grid>
</Window>
