<Window x:Class="_3ISIP223_PogosyanWPF.Windows.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
        
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Windows" WindowStartupLocation="CenterOwner"
        mc:Ignorable="d"
        Title="UserEditWindow" Height="485" Width="530" MinHeight="485" MinWidth="530">
    <Grid>
        <Grid Margin="15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="0 5 50 5">
                <materialDesign:PackIcon Kind="Account" Width="25" Height="25"/>
                <TextBlock Text="Имя" VerticalAlignment="Center" Margin="5 0" FontSize="15" Foreground="#FF70778F"/>
            </StackPanel>
            <TextBox Grid.Row="0" Grid.Column="1" Text="Иван Петров" VerticalAlignment="Center" FontSize="15"/>

            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="0 5 50 5">
                <materialDesign:PackIcon Kind="AccountKey" Width="25" Height="25"/>
                <TextBlock Text="Логин" VerticalAlignment="Center" Margin="5 0" FontSize="15" Foreground="#FF70778F"/>
            </StackPanel>
            <TextBox Grid.Row="1" Grid.Column="1" Text="ivan.petrov" VerticalAlignment="Center" FontSize="15"/>

            <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Margin="0 5 50 5">
                <materialDesign:PackIcon Kind="Email" Width="25" Height="25"/>
                <TextBlock Text="Email" VerticalAlignment="Center" Margin="5 0" FontSize="15" Foreground="#FF70778F"/>
            </StackPanel>
            <TextBox Grid.Row="2" Grid.Column="1" Text="ivan@example.com" VerticalAlignment="Center" FontSize="15"/>

            <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Margin="0 5 50 5">
                <materialDesign:PackIcon Kind="GuyFawkesMask" Width="25" Height="25"/>
                <TextBlock Text="Роль" VerticalAlignment="Center" Margin="5 0" FontSize="15" Foreground="#FF70778F"/>
            </StackPanel>
            <!--<TextBlock  Grid.Column="1" Text="Пользователь" VerticalAlignment="Center" FontSize="15"/>-->
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{Binding AvailableRoles}"
                      SelectedValue="{Binding CurrentRole}"
                      MinWidth="100">
            </ComboBox>

            <StackPanel Orientation="Horizontal" Grid.Row="4" Grid.Column="0" Margin="0 5 50 5">
                <materialDesign:PackIcon Kind="Password" Width="25" Height="25"/>
                <TextBlock Text="Пароль" VerticalAlignment="Center" Margin="5 0" FontSize="15" Foreground="#FF70778F"/>
            </StackPanel>
            <TextBox Grid.Row="4" Grid.Column="1" Text="ivan@example.com" VerticalAlignment="Center" FontSize="15"/>

            <GroupBox Grid.Row="5" Margin="0 10" Grid.ColumnSpan="4">
                <GroupBox.Header >
                    <StackPanel Orientation="Horizontal" >
                        <materialDesign:PackIcon Kind="BrainFreeze" Width="20" Height="20" Foreground="White"/>
                        <TextBlock Text="Заморозка аккаунта" FontSize="16" Margin="7 0" Foreground="White"/>
                    </StackPanel>
                </GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Orientation="Horizontal" Margin="0 0 50 5">
                        <materialDesign:PackIcon Kind="ListStatus" Width="25" Height="25"/>
                        <TextBlock Text="Статус" VerticalAlignment="Center" Margin="5 0" FontSize="15" Foreground="#FF70778F"/>
                    </StackPanel>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="Активно" VerticalAlignment="Center" FontSize="15"/>
                    
                    
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 5 10 0">
                        <materialDesign:PackIcon Kind="MessageText" Width="25" Height="25"/>
                        <TextBlock Text="Причина заморозки" VerticalAlignment="Center" Margin="5 0" FontSize="15" Foreground="#FF70778F"/>
                    </StackPanel>
                    <ComboBox Grid.Row="1" Grid.Column="1" Text="Активно" MinWidth="150" VerticalAlignment="Center"  FontSize="15"/>

                    <Button Content="Заморозить" Grid.Row="2" Margin="0 15 0 0" HorizontalAlignment="Left"/>

                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="6" Margin="0 10" Grid.ColumnSpan="2" Orientation="Horizontal" >
                <Button Content="Отмена" BorderBrush="Transparent"  HorizontalAlignment="Left" FontSize="14"  Style="{StaticResource MaterialDesignFlatLightBgButton}" Click="btnCancel_Click" />
                <Button Content="Сохранить" 
                                    HorizontalAlignment="Left" FontSize="14" Margin="20 0" Click="btnSave_Click" />

            </StackPanel>

        </Grid>

    </Grid>
</Window>
