<Window x:Class="_3ISIP223_PogosyanWPF.ResulLevelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF"
        mc:Ignorable="d"
        Title="ResulLevelWindow" Height="164" Width="200" Background="Transparent" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize">

    <Grid>
        <Grid Height="164" Width="200" x:Name="gridWIN" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="0.6*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.Background>
                <ImageBrush ImageSource="/Icons/interface/frameWin.png" Stretch="Uniform"/>
            </Grid.Background>
            <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="23"  Margin="0,5,7,0" Style="{StaticResource ElementInvent}" MouseLeftButtonDown="BorderNext_MouseLeftButtonDown">
                <Image Source="/Icons/interface/btn/CencelButton.png"  />

            </Border>

            <!--<TextBlock Grid.Row="1" Text="Dungeon" HorizontalAlignment="Center" VerticalAlignment="Center" />-->

            <Grid Grid.Row="2" Margin="0 ">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding step, StringFormat='\Level {0}'}" Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="7"/>
                <TextBlock Text="{Binding Score, StringFormat='\SCORE {0}'}" Margin="0 5" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" FontSize="7" Foreground="#FF603928"/>
                <Border Style="{StaticResource ElementInvent}" Grid.Row="2" Width="90" Padding="13 0 13 5" MouseLeftButtonDown="BorderNext_MouseLeftButtonDown" >
                    <Image Source="/Icons/interface/btn/btnNext.png"/>
                </Border>
            </Grid>

        </Grid>
        <Grid Height="164" Width="200" Visibility="Collapsed" x:Name="gridTRYAGAIN" >
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid.Background>
                <ImageBrush ImageSource="/Icons/interface/frameTryAgain.png" Stretch="Uniform"/>
            </Grid.Background>
            <Border Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Top" Width="23"  Margin="0,5,7,0" Style="{StaticResource ElementInvent}" MouseLeftButtonDown="BorderClose_MouseLeftButtonDown">
                <Image Source="/Icons/interface/btn/CencelButton.png"  />

            </Border>

            <!--<TextBlock Grid.Row="1" Text="Dungeon" HorizontalAlignment="Center" VerticalAlignment="Center" />-->

            <Grid Grid.Row="2" Margin="0 5" VerticalAlignment="Bottom">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="{Binding step, StringFormat='\Level {0}'}" Grid.Row="0" HorizontalAlignment="Center" FontSize="7"/>
                <Border Style="{StaticResource ElementInvent}" Grid.Row="1" Width="90" Padding="13 5" MouseLeftButtonDown="BorderBtnAgain_MouseLeftButtonDown" >
                    <Image Source="/Icons/interface/btn/btnAgain.png"/>
                </Border>
            </Grid>

        </Grid>

    </Grid>
</Window>
