<Page x:Class="_3ISIP223_PogosyanWPF.Pages._2ProtductsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_2ProtductsPage" d:Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Button Content="Назад" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"/>
        <Grid Grid.Column="1" HorizontalAlignment="Right">
            <Button Content="Корзина" />
            <Border HorizontalAlignment="Right" Margin="5" Width="25" Height="20" VerticalAlignment="Top" Background="#FFF55123" CornerRadius="5">
                <TextBlock Text="99"  HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Фильтры" FontSize="17" FontWeight="Bold"/>
            <StackPanel Grid.Row="1" Margin="0 0 10 10">
                <TextBlock Text="Тип товара" FontSize="16" Margin="0 5"/>
                <ComboBox Width="150"  IsEditable="True" HorizontalAlignment="Left"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0 0 10 10">
                <TextBlock Text="Производитель" FontSize="16" Margin="0 5"/>
                <ComboBox Width="150"  IsEditable="True" HorizontalAlignment="Left"/>
            </StackPanel>

            <TextBlock Text="Сортировка" Grid.Row="3" FontSize="17" FontWeight="Bold"/>
            <StackPanel Grid.Row="4" Margin="0 10 10 10">
                <TextBlock Text="По оценке" FontSize="16" Margin="0 5"/>
                <ComboBox Width="150"  IsEditable="True" HorizontalAlignment="Left" />
            </StackPanel>

            <Button Grid.Row="5" Margin="0 5" Content="Применить" HorizontalAlignment="Center" />
        </Grid>

        <ListBox Grid.Row="1" Grid.Column="1" d:ItemsSource="{d:SampleData ItemCount=2}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="10" Padding="10">
                        <Grid >
                            <Grid.RowDefinitions >
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="ШАМПУНЬ 'ОБЪЕМ'" Grid.Row="0" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                            <Border Grid.Row="1" Background="LightPink" Padding="5" HorizontalAlignment="Left" CornerRadius="7" Margin="5">
                                <TextBlock Text="1 200 ₽" FontSize="16" FontWeight="Medium"/>
                            </Border>
                            <TextBlock Text="L'Oreal" Grid.Row="2" FontSize="15" Margin="5 5" FontWeight="Medium"/>
                            <TextBlock Text="⭐ 4.2" Grid.Row="3" FontSize="15" Margin="5 0" FontWeight="Medium"/>
                            <Button Content="Добавить в корзину" Style="{StaticResource AddButton}" Grid.Row="4" Margin="5"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

    </Grid>
</Page>
