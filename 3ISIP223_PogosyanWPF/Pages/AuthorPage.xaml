<Page x:Class="_3ISIP223_PogosyanWPF.Pages.AuthorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorPage">

    <Grid>
        <TabControl Style="{StaticResource MaterialDesignNavigationRailTabControl}" TabStripPlacement="Top">
            <TabItem Header="Мои книги" Width="110">
                <Frame  NavigationUIVisibility="Hidden" Source="/Pages/AuthorPages/PublishedBooksPage.xaml" Margin="10"/>

            </TabItem>
            <TabItem Header="Замороженные книги" Width="110">
                <Frame  NavigationUIVisibility="Hidden" Source="/Pages/AuthorPages/FrozenBooksPage.xaml" Margin="10"/>

            </TabItem>
        </TabControl>
    </Grid>
</Page>
