<Page x:Class="_3ISIP223_PogosyanWPF.Pages._1AccountPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_1AccountPage" d:Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>


        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="МОЙ АККАУНТ" HorizontalAlignment="Center" FontSize="19" FontWeight="Medium" Grid.Column="1" VerticalAlignment="Center"/>
            <Button Content="Назад" FontSize="14" Grid.Column="0" Padding="10 5" Margin="10"/>
        </Grid>
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="ФИО" Grid.Row="0" Grid.Column="0" FontSize="16"/>
            <TextBlock Text="Погосян Эдик" Grid.Row="0" Grid.Column="1" FontSize="16"/>
            <TextBlock Text="Телефон" Grid.Row="1" Grid.Column="0" FontSize="16" Margin="0 5 20 5"/>
            <TextBlock Text="+7 (999) 123-45-67" Grid.Row="1" Grid.Column="1" FontSize="16" VerticalAlignment="Center"/>
            <TextBlock Text="Почта" Grid.Row="2" Grid.Column="0" FontSize="16"/>
            <TextBlock Text="memat@gmail.com" Grid.Row="2" Grid.Column="1" FontSize="16"/>
            
        </Grid>

        <StackPanel Grid.Row="2" Margin="10">
            <TextBlock Text="ИСТОРИЯ ЗАПИСЕЙ" FontSize="16" FontWeight="Medium" Margin="0 0 0 10"/>
            <ListBox d:ItemsSource="{d:SampleData ItemCount=2}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="{x:Null}" >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#7FFFCCCC" CornerRadius="10" Padding="10">
                            <Grid >
                                <Grid.ColumnDefinitions >
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="📅 15.04.2026" Grid.Column="0" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                                <TextBlock Text="🕐 10:00" Grid.Column="1" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                                <TextBlock Text="✨ Маникюр" Grid.Column="2" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                                <TextBlock Text="👩 Анна" Grid.Column="3" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                                <TextBlock Text="Выполнено" Grid.Column="4" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                                
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

        </StackPanel>
        

        <StackPanel Grid.Row="3" Margin="10">
            <TextBlock Text="ИСТОРИЯ ЗАКАЗОВ" FontSize="16" FontWeight="Medium" Margin="0 0 0 10"/>
            <ListBox d:ItemsSource="{d:SampleData ItemCount=1}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="{x:Null}" >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#7F000000" BorderThickness="1" CornerRadius="10" Padding="10">
                            <Grid >
                                <Grid.ColumnDefinitions >
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="🧾 ЗАКАЗ №1245" Grid.Column="0" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                                <TextBlock Text="📅 15.04.2026" Grid.Column="1" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                                <TextBlock Text="💵 Карта" Grid.Column="2" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                                <TextBlock Text="👩 2 333.00 ₽" Grid.Column="3" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                                <TextBlock Text="Выдан" Grid.Column="4" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                                <StackPanel Grid.Row="1" Grid.ColumnSpan="6">
                                    <ListBox Grid.Row="1" Margin="5 3 5 0" Grid.ColumnSpan="5" d:ItemsSource="{d:SampleData ItemCount=5}" ScrollViewer.HorizontalScrollBarVisibility="Auto" BorderBrush="{x:Null}"  >
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Шампунь 'Объем'"/>
                                                <TextBlock Text="x1" Margin="5 0 0 0" Foreground="Blue"/>
                                                <TextBlock Text="|" Margin="10 0 0 0"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                    
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                    
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

        </StackPanel>
        
        
    </Grid>
</Page>
