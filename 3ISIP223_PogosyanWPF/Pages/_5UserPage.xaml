<Page x:Class="_3ISIP223_PogosyanWPF.Pages._5UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_5UserPage" Background="White" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Border  HorizontalAlignment="Left" BorderBrush="Gray" Margin="10 5 0 0" BorderThickness="1" CornerRadius="5">
            <Button Grid.Row="0" Content="Назад" Padding="5" FontSize="15" Width="60" BorderBrush="{x:Null}" Background="Transparent" Click="btnBack_Click" />
        </Border>


        <TextBlock Text="ЛИЧНЫЕ ДАННЫЕ" Grid.Row="1" FontSize="20" Margin="10 15 10 0" FontWeight="Medium"/>
        <Grid Grid.Row="2" Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Имя" Grid.Column="0" Grid.Row="0" FontSize="16" Margin="5" Foreground="Gray" FontWeight="Medium"/>
            <TextBlock Text="{Binding User.Name}" Grid.Column="1" Grid.Row="0" FontSize="16" Margin="5" FontWeight="Medium"/>

            <TextBlock Text="Email" Grid.Column="0" Grid.Row="1" FontSize="16" Margin="5" Foreground="Gray" FontWeight="Medium"/>
            <TextBlock Text="{Binding User.Email}" Grid.Column="1" Grid.Row="1" FontSize="16" Margin="5" FontWeight="Medium"/>
            
            <TextBlock Text="Дата рождения" Grid.Column="0" Grid.Row="2" FontSize="16" Margin="5 5 20 5" Foreground="Gray" FontWeight="Medium"/>
            <TextBlock Text="{Binding User.BirthDate, StringFormat='\{0:dd MMMM yyyy}'}" Grid.Column="1" Grid.Row="2" FontSize="16" Margin="5" FontWeight="Medium"/>
            
            <TextBlock Text="Всего билетов" Grid.Column="0" Grid.Row="3" FontSize="16" Margin="5" Foreground="Gray" FontWeight="Medium"/>
            <TextBlock Text="{Binding GetCountTickets}" Grid.Column="1" Grid.Row="3" FontSize="16" Margin="5" FontWeight="Medium"/>


        </Grid>

            <TextBlock Text="Мои билеты" Grid.Row="3" FontSize="20" Margin="10 0 10 5" FontWeight="Medium"/>

        <Grid Grid.Row="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel  Background="#FFC3C3C8" Height="1" Grid.Row="0" Margin="10 10" />

            <ListBox Grid.Row="1" x:Name="lstMyTickets" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderThickness="0"  ItemsSource="{Binding Tickets}" Margin="5" Visibility="Visible" d:ItemsSource="{d:SampleData ItemCount=5}" Height="210">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <WrapPanel Margin="0 0 5 5">
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8"> 
                                
                                <Grid MinWidth="300" Margin="5">
                                    <Grid.ColumnDefinitions >
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions >
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>
                                
                                    <TextBlock Text="{Binding Session.Film.Name}" Grid.Column="0" Grid.Row="0" Margin="3" VerticalAlignment="Center" FontSize="14" FontWeight="Medium"/>
                                    <Border Background="#FF3BB33B" Margin="5" Grid.Column="1" Grid.Row="0" MinWidth="32" HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <!--<TextBlock Text="{Binding Rating}" FontWeight="Medium" HorizontalAlignment="Center" Padding="2" FontSize="16" Foreground="White" VerticalAlignment="Center"/>-->
                                        <TextBlock Text="{Binding Session.Film.Rating}" FontWeight="Medium" HorizontalAlignment="Center" Padding="2" FontSize="14" Foreground="White" VerticalAlignment="Center"/>
                                    </Border>
                                
                                    <TextBlock Text="{Binding Session.StartDateTime, StringFormat='\{0:dd MMMM yyy, HH:MM }'}" Grid.Column="0" Grid.Row="1" Margin="3 3 20 3" FontSize="14" FontWeight="Medium"/>
                                    <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal">
                                        <TextBlock Text="{Binding Seat.RowNumber, StringFormat='\{0} ряд, '}"  Margin="3" FontSize="14" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding Seat.SeatNumber, StringFormat='\{0} место'}"  Margin="3" FontSize="14" FontWeight="Medium"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="0" Grid.Row="2" Orientation="Horizontal" >
                                        <TextBlock Text="{Binding Session.Hall.Name}" FontSize="14" FontWeight="Medium" Margin="3"/>
                                        <TextBlock Text="{Binding Session.Hall.HallRating.Name, StringFormat=({0})}" FontSize="14" Margin="3" FontWeight="Medium"/>
                                    </StackPanel>

                                    <TextBlock Text="{Binding Session.BasePrice, StringFormat='\{0} ₽'}" Grid.Column="1" Grid.Row="2" Margin="3 3 20 3" FontSize="14" FontWeight="Medium"/>
                                    
                                    
                                </Grid>
                            </Border>
                        </WrapPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                
                
            </ListBox>

            <TextBlock x:Name="txtNoneTickets" Text="Билеты не найдены" Grid.Row="1" Visibility="Collapsed" Foreground="Gray" FontSize="25" Margin="10 20" FontWeight="Medium"/>

        </Grid>
        <StackPanel  Background="#FFC3C3C8" Height="1" Margin="10 10" Grid.Row="5" />



    </Grid>
</Page>
