<Page x:Class="_3ISIP223_PogosyanWPF.Pages._3UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      Title="_3UserPage">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Мои сборки" Grid.Row="0"  Margin="10" VerticalAlignment="Center" FontSize="15"/>
        <Border Grid.Column="1" Margin="10" HorizontalAlignment="Right" BorderBrush="Gray" CornerRadius="3" BorderThickness="1">
            <Button Content="Назад" FontSize="14" Padding="10 5" Background="Transparent" BorderBrush="Transparent" Click="Button_Click"/>
        </Border>

        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Grid.Row="1" ItemsSource="{Binding MySborki}" SelectionChanged="ListBox_SelectionChanged" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0 5" BorderThickness="0.5" BorderBrush="#f2f2f2" CornerRadius="7">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="5" Opacity="0.5" RenderingBias="Performance" ShadowDepth="1" Direction="310"/>
                        </Border.Effect>
                        
                        <Grid Background="Transparent" Margin="0 0 0 0">

                            <Grid Grid.Row="0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Border Background="#f2f2f2" Grid.Row="0" Grid.ColumnSpan="2" Padding="10" CornerRadius="6 6 0 0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name.name}" FontSize="16" FontWeight="Medium"/>
                                        <Border Grid.Column="1" HorizontalAlignment="Right" BorderBrush="Gray" CornerRadius="3" BorderThickness="1">
                                            <Button Content="Удалить" FontSize="14" Padding="10 5" Background="Transparent" BorderBrush="Transparent"/>
                                        </Border>
                                        <!--<Button Grid.Column="1" Padding="3" HorizontalAlignment="Right" Content="Удалить"/>-->
                                    </Grid>
                                </Border>

                            </Grid>

                            <Border Grid.Row="1" Background="White" CornerRadius="0 0 7 7 " Padding="5">
                                <Grid >
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <ListBox BorderThickness="0" Margin="0 10 0 5" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             d:ItemsSource="{d:SampleData ItemCount=5}"
                                             ItemsSource="{Binding baseparts}" SelectionChanged="ListBox_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <WrapPanel>

                                                    <Border Background="#F6F6F6" Padding="10" CornerRadius="10">
                                                        <!--<TextBlock Text="1"/>-->
                                                        <Image Source="{Binding image}" Height="55" Width="55"/>
                                                    </Border>
                                            
                                                </WrapPanel>

                                            </DataTemplate>
                                        </ListBox.ItemTemplate>


                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>

                                    <TextBlock Grid.Row="1" Grid.Column="0" FontSize="15"  TextWrapping="WrapWithOverflow" Padding="5 5" Text="{Binding FullAllName}" />
                                    <TextBlock Grid.Column="1" Grid.Row="1" FontSize="15"  Padding="5 5" FontWeight="Bold"  HorizontalAlignment="Right" Text="{Binding TotalSum, StringFormat='\{0:F2} ₽'}" />
                                </Grid>
                            </Border>
    

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            


                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    
    
    </Grid>
</Page>
