<Page x:Class="_3ISIP223_PogosyanWPF.Pages._3UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450"
      Title="_3UserPage">

    <Grid Background="White">

        <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0 5" BorderThickness="1" BorderBrush="#f2f2f2" CornerRadius="5">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Background="#f2f2f2" Grid.Row="0" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="komp" Padding="5" FontWeight="Medium"/>
                                <Border Grid.Column="1" HorizontalAlignment="Right" BorderBrush="Gray" CornerRadius="3" BorderThickness="1">
                                    <Button Content="Удалить" FontSize="14" Padding="3" Background="Transparent" BorderBrush="Transparent"/>
                                </Border>
                                <!--<Button Grid.Column="1" Padding="3" HorizontalAlignment="Right" Content="Удалить"/>-->
                            </Grid>

                            <ListBox BorderThickness="0" Margin="0 10" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <WrapPanel>

                                            <Border Background="#F6F6F6" Padding="5" Height="55" Width="55">
                                                <Image Source="/proc.jpg" />
                                            </Border>
                                        </WrapPanel>

                                    </DataTemplate>
                                </ListBox.ItemTemplate>


                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>

                            <TextBlock Padding="5" Grid.Row="2" Grid.ColumnSpan="1" TextWrapping="WrapWithOverflow" Text="AMD Ryzen 7 9800X3D OEM | MSI MPG B550 GAMING PLUS | Palit GeForce RTX 5090 GameRock | Блок питания DEEPCOOL PF750 черный" />
                            <TextBlock Grid.Column="2" Grid.Row="2" FontSize="15" Padding="10 0 0 0" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" Text="390 496 ₽" />

                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
