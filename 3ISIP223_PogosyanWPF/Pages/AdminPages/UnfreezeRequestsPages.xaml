<Page x:Class="_3ISIP223_PogosyanWPF.Pages.AdminPages.UnfreezeRequestsPages"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels.AdminViewModels"
      mc:Ignorable="d" 
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
      d:Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UnfreezeRequestsPages" Loaded="Page_Loaded">

    <Page.DataContext>
        <local:UnfreezeRequestsViewModel/>
    </Page.DataContext>
    <Grid>
        <Grid HorizontalAlignment="Center" Visibility="Collapsed" x:Name="absenceVisible">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <materialDesign:PackIcon Kind="TruckSnowflake" Height="130" Width="130" HorizontalAlignment="Center" Foreground="#FFA9A9B4"/>
            <TextBlock Grid.Row="1" Text="Нет новых заявок на разморозку" Margin="0 10 0 5" Style="{StaticResource H1Text}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="Все заявки обработаны." 
                       FontSize="17"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}" HorizontalAlignment="Center" Foreground="#FFA9A9B4"/>
        </Grid>

        <ScrollViewer Visibility="Visible" VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="LstComplaints" 
                      HorizontalContentAlignment="Stretch" 
                      ItemsSource="{Binding UnfreezeRequests}" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#FFE9EBF0" BorderThickness="0,0,0,1" Padding="15 10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <materialDesign:PackIcon Kind="Lock" Height="25" Width="25" Margin="0,0,10,0"/>
                                        <TextBlock Style="{StaticResource H4Text}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <Run Text="Заявки на снятие заморозки #"/><Run Text="{Binding RequestId}"/>
                                        </TextBlock>
                                        <Border Background="{Binding StatusesRequest.GetColorStatus}" CornerRadius="10" Padding="6,2,6,2" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding  StatusesRequest.Name}" FontSize="11" Foreground="White" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="{Binding CreatedAt, StringFormat='dd MMMM yyyyy'}" FontSize="12" Foreground="#FF626165" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,5">
                                    <materialDesign:PackIcon Kind="Account" Height="18" Width="18" Foreground="#FF70778F"/>
                                    <TextBlock Margin="5,0,0,0" FontSize="13" Foreground="#FF70778F">
                                    <Run Text="Пользователь:"/>
                                    <Run Text="{Binding User.DisplayName}" Foreground="#FF3D3DC7" FontWeight="SemiBold"/>
                                    <Run Text="(ID:" />
                                    <Run Text="{Binding UserId}" />
                                    <Run Text=")" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                                    <materialDesign:PackIcon Kind="Target" Height="18" Width="18" Foreground="#FF70778F"/>
                                    <TextBlock Margin="5,0,0,0" FontSize="13" Foreground="#FF70778F">
                                    <Run Text="Тип:"/>
                                    <Run Text="{Binding GetComplType}" Foreground="#FF3D3DC7" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,5" Visibility="{Binding GetIsBook}">
                                    <materialDesign:PackIcon Kind="BookOpen" Height="18" Width="18" Foreground="#FF70778F"/>
                                    <TextBlock Margin="5,0,0,0" FontSize="13" Foreground="#FF70778F">
                                    <Run Text="Книга:"/>
                                    <Run Text="{Binding Book.User.DisplayName}" Foreground="#FF3D3DC7" FontWeight="SemiBold"/>
                                    <Run Text=": &quot;" />
                                    <Run Text="{Binding Book.Title}" Foreground="#FF13192E"/>
                                    <Run Text="&quot; (ID:" />
                                    <Run Text="{Binding BookId}" />
                                    <Run Text=")" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Margin="0 5">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Message" Height="18" Width="18" Foreground="#FF70778F"/>
                                        <TextBlock FontSize="12" Foreground="#FF70778F" Margin="5 0">
                                        <Run Text="Причина оспаривания:"/>
                                        </TextBlock>

                                    </StackPanel>

                                    <Border Background="#FFF4F4FC" CornerRadius="8" Padding="12 8">
                                        <TextBlock Text="{Binding Reason}"
                                               FontSize="13" Foreground="#FF13192E" TextWrapping="WrapWithOverflow"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Row="5" Orientation="Horizontal" Visibility="{Binding  VisibilityButtons}" HorizontalAlignment="Right" Margin="0 5 0 0">
                                    <Button x:Name="BtnAccept" Tag="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}" 
                                        Margin="0 0 10 0" Click="BtnAccept_Click">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Check" Height="18" Width="18" Foreground="#FF04BE5A"/>
                                            <TextBlock Text="Принять" Margin="5 0 0 0" Foreground="#FF04BE5A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnReject" Tag="{Binding}"
                                        Style="{StaticResource MaterialDesignFlatButton}" Click="BtnReject_Click" 
                                        >
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Close" Height="18" Width="18" Foreground="#FFE74C3C"/>
                                            <TextBlock Text="Отклонить" Margin="5 0 0 0" Foreground="#FFE74C3C" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
