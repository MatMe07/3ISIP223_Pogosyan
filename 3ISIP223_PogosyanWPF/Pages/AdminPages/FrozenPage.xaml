<Page x:Class="_3ISIP223_PogosyanWPF.Pages.AdminPages.FrozenPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels.AdminViewModels"
      mc:Ignorable="d" 
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
       d:Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FrozenPage" Loaded="Page_Loaded">
    <Page.DataContext>
        <local:FrozenViewModel/>
    </Page.DataContext>
    <Grid>
        <Grid HorizontalAlignment="Center" Visibility="Collapsed" x:Name="absenceVisible">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <materialDesign:PackIcon Kind="Snowflake" Height="130" Width="130" HorizontalAlignment="Center" Foreground="#FFA9A9B4"/>
            <TextBlock Grid.Row="1" Text="Нет замороженных объектов" Margin="0 10 0 5" Style="{StaticResource H1Text}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="Все объекты активны." 
                       FontSize="17"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}" HorizontalAlignment="Center" Foreground="#FFA9A9B4"/>
        </Grid>

        <Grid Visibility="Visible">
            <TabControl >
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Books" Width="20" Height="20"/>
                            <TextBlock Text="Книги" Margin="5 0" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LstFrozenBooks" 
                              HorizontalContentAlignment="Stretch" 
                              ItemsSource="{Binding FrozenBooks}" d:ItemsSource="{d:SampleData ItemCount=5}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFE9EBF0" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                    <materialDesign:PackIcon Kind="Book" Height="25" Width="25" Margin="0,0,10,0" Foreground="#FF3D3DC7"/>
                                                    <TextBlock Style="{StaticResource H4Text}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                                        <Run Text="{Binding Title}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Border Grid.Column="1" Background="#FFE8F4FD" CornerRadius="10" Padding="10 5">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Snowflake" Height="16" Width="16" Foreground="#FF3D3DC7"/>
                                                        <TextBlock Text=" Заморожена" FontSize="13" Foreground="#FF3D3DC7"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0 7 0 5">
                                                <materialDesign:PackIcon Kind="Account" Height="17" Width="17" Foreground="#FF70778F"/>
                                                <TextBlock Margin="5,0,0,0" FontSize="14" Foreground="#FF70778F">
                                            <Run Text="Автор:"/>
                                            <Run Text="{Binding User.DisplayName}" Foreground="#FF3D3DC7" FontWeight="SemiBold"/>
                                            <Run Text="(ID:" />
                                            <Run Text="{Binding AuthorId}" />
                                            <Run Text=")" />
                                                </TextBlock>
                                            </StackPanel>


                                            <StackPanel Grid.Row="2" Margin="0 0 0,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Message" Height="17" Width="17" Foreground="#FF70778F"/>

                                                    <TextBlock FontSize="14" Foreground="#FF70778F" Margin="5,0,0,3" VerticalAlignment="Center">
                                                        <Run Text="Причина заморозки:"/>
                                                    </TextBlock>

                                                </StackPanel>
                                                <Border Background="#FFF4F4FC" CornerRadius="8" Padding="12 8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Reason.Name}" FontSize="13" Foreground="#FF13192E"
                                                                   TextWrapping="WrapWithOverflow"/>

                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>


                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </ScrollViewer>

                </TabItem>
                
                
                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Users" Width="20" Height="20"/>
                            <TextBlock Text="Пользователи" Margin="5 0" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="Visible">
                        <ItemsControl x:Name="LstFrozenUsers" 
                      HorizontalContentAlignment="Stretch" 
                      ItemsSource="{Binding FrozenUsers}" d:ItemsSource="{d:SampleData ItemCount=5}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFE9EBF0" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                    <Border CornerRadius="5" Width="35" Height="35" Margin="0,0,10,0">
                                                        <Border.Background>
                                                            <ImageBrush ImageSource="/NoneUserPath.png"/>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource H4Text}" FontSize="15" FontWeight="SemiBold"/>
                                                        <TextBlock FontSize="12">
                                            <Run Text="Логин:" Foreground="#FF70778F"/>
                                            <Run Text="{Binding Login}" Foreground="#FF13192E"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>

                                                <Border Grid.Column="1" Background="#FFE8F4FD" CornerRadius="10" Padding="10 5" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Snowflake" Height="16" Width="16" Foreground="#FF3D3DC7"/>
                                                        <TextBlock Text=" Заморожен" FontSize="13" Foreground="#FF3D3DC7"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,5">
                                                <materialDesign:PackIcon Kind="Email" Height="20" Width="17" Foreground="#FF70778F"/>
                                                <TextBlock Margin="5,0,15,0" FontSize="14" Foreground="#FF13192E" Text="{Binding Email}"/>

                                                <materialDesign:PackIcon Kind="GuyFawkesMask" Height="20" Width="17" Foreground="#FF70778F"/>
                                                <TextBlock Margin="5,0,0,0" FontSize="14" Foreground="#FF70778F">
                                    <Run Text="Роль:"/>
                                    <Run Text="{Binding Role.RoleName}" Foreground="#FF3D3DC7" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Row="2" Margin="0,0,0,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Message" Height="20" Width="17" Foreground="#FF70778F"/>
                                                    <TextBlock FontSize="14" Foreground="#FF70778F" Margin="5,0,0,3" VerticalAlignment="Center">
                                        <Run Text="Причина заморозки:"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Background="#FFF4F4FC" CornerRadius="8" Padding="12 8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Reason.Name}" FontSize="13" Foreground="#FF13192E" TextWrapping="WrapWithOverflow"
                                                   >
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsReason}" Value="Visible">
                                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="Причина не указана" FontSize="13" Foreground="#FFA9A9B4"
                                                   Visibility="{Binding IsReason}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </TabItem>

                <TabItem>
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MessageText" Width="20" Height="20"/>
                            <TextBlock Text="Отзывы" Margin="5 0" VerticalAlignment="Center" FontSize="14"/>
                        </StackPanel>
                    </TabItem.Header>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="LstFrozenReviews" 
                      HorizontalContentAlignment="Stretch" 
                      ItemsSource="{Binding Reviews}" d:ItemsSource="{d:SampleData ItemCount=5}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#FFE9EBF0" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                                <RowDefinition Height="auto"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                    <materialDesign:PackIcon Kind="MessageText" Height="25" Width="25" Margin="0,0,10,0" Foreground="#FF3D3DC7"/>
                                                    <TextBlock Style="{StaticResource H4Text}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <Run Text="Отзыв #"/><Run Text="{Binding ReviewId}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <Border Grid.Column="1" Background="#FFE8F4FD" CornerRadius="10" Padding="10 5" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Snowflake" Height="16" Width="16" Foreground="#FF3D3DC7"/>
                                                        <TextBlock Text=" Заморожен" FontSize="13" Foreground="#FF3D3DC7"/>
                                                    </StackPanel>
                                                </Border>
                                            </Grid>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,7,0,5">
                                                <materialDesign:PackIcon Kind="Account" Height="17" Width="17" Foreground="#FF70778F"/>
                                                <TextBlock Margin="5,0,15,0" FontSize="14" Foreground="#FF70778F">
                                    <Run Text="Пользователь:"/>
                                    <Run Text="{Binding User.DisplayName}" Foreground="#FF3D3DC7" FontWeight="SemiBold"/>
                                                </TextBlock>

                                                <materialDesign:PackIcon Kind="Book" Height="17" Width="17" Foreground="#FF70778F"/>
                                                <TextBlock Margin="5,0,0,0" FontSize="14" Foreground="#FF70778F">
                                    <Run Text="К книге:"/>
                                    <Run Text="{Binding Book.Title}" Foreground="#FF13192E" FontWeight="SemiBold"/>
                                                </TextBlock>
                                            </StackPanel>

                                            <StackPanel Grid.Row="3" Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Message" Height="17" Width="17" Foreground="#FF70778F"/>
                                                    <TextBlock FontSize="14" Foreground="#FF70778F" Margin="5,0,0,3" VerticalAlignment="Center">
                                        <Run Text="Текст отзыва:"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Background="#FFF4F4FC" CornerRadius="8" Padding="12 5">
                                                    <TextBlock Text="{Binding Comment}" FontSize="13" Foreground="#FF13192E" TextWrapping="WrapWithOverflow"
                                               MaxHeight="80"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Grid.Row="4" Margin="0,0,0,5">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="Alert" Height="17" Width="17" Foreground="#FF70778F"/>
                                                    <TextBlock FontSize="14" Foreground="#FF70778F" Margin="5,0,0,3" VerticalAlignment="Center">
                                        <Run Text="Причина заморозки:"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <Border Background="#FFF4F4FC" CornerRadius="8" Padding="12 5">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Reason.Name}" FontSize="13" Foreground="#FF13192E" TextWrapping="WrapWithOverflow"
                                                   Visibility="Visible"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</Page>
