<Page x:Class="_3ISIP223_PogosyanWPF.Pages.AdminPages.UsersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages.AdminPages"
                  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
       d:Background="White"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="UsersPage">

    <Grid>
        <DataGrid x:Name="DgUsers" 
          AutoGenerateColumns="False"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          Margin="0,10,0,10"
          BorderBrush="#FFE9EBF0" HorizontalContentAlignment="Stretch"
          BorderThickness="1"
                  ItemsSource="{Binding adminUsers}" d:ItemsSource="{d:SampleData ItemCount=5}"
          Background="White" GridLinesVisibility="Horizontal">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                            Binding="{Binding ID}" IsReadOnly="True" CanUserResize="True" CanUserReorder="False"  
                            >
                </DataGridTextColumn>

                <DataGridTextColumn Header="Логин" 
                            Binding="{Binding Login}" IsReadOnly="True"
                            MinWidth="150">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>


                <DataGridTextColumn Header="Email" 
                            Binding="{Binding Email}" IsReadOnly="True"
                            MinWidth="150"/>


                <DataGridTextColumn Header="Имя" 
                            Binding="{Binding Name}"
                            MinWidth="100"/>

                <DataGridTemplateColumn Header="Роль" MinWidth="100">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox ItemsSource="{Binding AvailableRoles}"
                      SelectedValue="{Binding CurrentRole}"
                      >
                            </ComboBox>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>

                <DataGridTemplateColumn Header="Действие" MinWidth="135">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <Button x:Name="BtnChangePassword"
                                    Tag="{Binding ID}" 
                                    Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Click="btnEditUser_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Edit" Height="14" Width="14"/>
                                    <TextBlock Text="Редактировать" Margin="5,0,0,0" FontSize="12"/>
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>



            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
