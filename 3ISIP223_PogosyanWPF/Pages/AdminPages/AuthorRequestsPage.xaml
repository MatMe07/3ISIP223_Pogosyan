<Page x:Class="_3ISIP223_PogosyanWPF.Pages.AdminPages.AuthorRequestsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages.AdminPages"
            xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
      d:Background="White"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthorRequestsPage">

    <Grid>
        <Grid HorizontalAlignment="Center" Visibility="Visible" x:Name="absenceVisible">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <materialDesign:PackIcon Kind="Typewriter" Height="130" Width="130" HorizontalAlignment="Center" Foreground="#FFA9A9B4"/>
            <TextBlock Grid.Row="1" Text="Нет новых заявок" Margin="0 10 0 5" Style="{StaticResource H1Text}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="Все заявки обработаны." 
                       FontSize="17"
                       Style="{StaticResource MaterialDesignHeadline6TextBlock}" HorizontalAlignment="Center" Foreground="#FFA9A9B4"/>
        </Grid>

        <ScrollViewer Visibility="Collapsed" VerticalScrollBarVisibility="Auto">

            <ItemsControl x:Name="LstComplaints" 
                      HorizontalContentAlignment="Stretch" 
                      ItemsSource="{Binding lstRand}" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="#FFE9EBF0" BorderThickness="0,0,0,1" Padding="15 10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                        <materialDesign:PackIcon Kind="Typewriter" Height="25" Width="25" Margin="0,0,10,0"/>
                                        <TextBlock Style="{StaticResource H4Text}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center">
                                        <Run Text="Заявка на роль автора #"/><Run Text="2345"/>
                                        </TextBlock>
                                        <Border Background="#FFFDE8E8" CornerRadius="10" Padding="6,2,6,2" Margin="10,0,0,0">
                                            <TextBlock Text=" На рассмотрении" FontSize="11" Foreground="#FFE74C3C" VerticalAlignment="Center"/>
                                        </Border>
                                    </StackPanel>

                                    <TextBlock Grid.Column="1" Text="15.04.2022" FontSize="12" Foreground="#FF626165" VerticalAlignment="Center"/>
                                </Grid>

                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,5">
                                    <materialDesign:PackIcon Kind="Account" Height="18" Width="18" Foreground="#FF70778F"/>
                                    <TextBlock Margin="5,0,0,0" FontSize="13" Foreground="#FF70778F">
                                    <Run Text="Пользователь:"/>
                                    <Run Text="Ivan Petrov" Foreground="#FF3D3DC7" FontWeight="SemiBold"/>
                                    <Run Text="(ID:" />
                                    <Run Text="12345" />
                                    <Run Text=")" />
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,5">
                                    <materialDesign:PackIcon Kind="Email" Height="18" Width="18" Foreground="#FF70778F"/>
                                    <TextBlock Margin="5,0,0,0" FontSize="13" Foreground="#FF70778F">
                                    <Run Text="Email:"/>
                                    <Run Text="petr@example.com" Foreground="#FF3D3DC7" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </StackPanel>

                                <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                                    <Button x:Name="BtnAccept" 
                                        Style="{StaticResource MaterialDesignFlatButton}" 
                                        Margin="0,0,10,0">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Check" Height="18" Width="18" Foreground="#FF04BE5A"/>
                                            <TextBlock Text="Принять" Margin="5,0,0,0" Foreground="#FF04BE5A" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="BtnReject" 
                                        Style="{StaticResource MaterialDesignFlatButton}" 
                                        >
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Close" Height="18" Width="18" Foreground="#FFE74C3C"/>
                                            <TextBlock Text="Отклонить" Margin="5,0,0,0" Foreground="#FFE74C3C" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
