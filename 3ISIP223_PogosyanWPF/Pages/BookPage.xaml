<Page x:Class="_3ISIP223_PogosyanWPF.Pages.BookPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" d:Background="White"
      Title="BookPage">
    <Page.Resources>
        <ContextMenu x:Key="ReviewListMenu">
            <MenuItem Header="Пожаловаться на отзыв" Tag="Пожаловаться на отзыв"/>
            <MenuItem Header="Заморозить отзыв" Tag="В планах"/>
        </ContextMenu>
        <ContextMenu x:Key="ReadingListMenu">
            <MenuItem Header="Заброшено" Tag="Заброшено"/>
            <MenuItem Header="В планах" Tag="В планах"/>
            <MenuItem Header="Читаю" Tag="Читаю"/>
            <MenuItem Header="Прочитано" Tag="Прочитано"/>
        </ContextMenu>
    </Page.Resources>

    <Page.DataContext>
        <local:BookViewModel/>
    </Page.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Button Grid.Column="0" Margin="10 5" Style="{StaticResource MaterialDesignToolForegroundButton}" 
                        Padding="0"  Foreground="Black" Height="30" 
                        materialDesign:RippleAssist.RippleSizeMultiplier="0.1"
                        materialDesign:RippleAssist.IsCentered="False"
                        Click="btnBack_Click" HorizontalAlignment="Left" >
            <Button.Content>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="LessThan" Height="20" Width="20"/>
                    <TextBlock Text="Назад" VerticalAlignment="Center" Margin="10 0" FontWeight="Bold" />
                </StackPanel>

            </Button.Content>
        </Button>
        <Grid Grid.Row="1" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Image Source="{Binding SelectedBook.CoverPath}" Width="185" MinHeight="100" VerticalAlignment="Top">
                <Image.Effect>
                    <DropShadowEffect BlurRadius="10" Opacity="0.5" ShadowDepth="0"/>
                </Image.Effect>
            </Image>
            <Button Content="Читать фрагмент" Style="{StaticResource MaterialDesignRaisedLightButton}"
                    FontWeight="Black" Foreground="White" Grid.Row="1" Margin="0 10" FontSize="12" Click="btnOpenReading_Click"/>
            <Button Content="🚩 Пожаловаться на книгу" Grid.Row="2"  HorizontalContentAlignment="Left" FontSize="12" Click="btnComplainBook_Click" >
                <Button.Style>
                    <Style BasedOn="{StaticResource MaterialDesignFlatButton}" TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger  Binding="{Binding IsAuthor}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="🚩 Пожаловаться на автора" Grid.Row="3"  HorizontalContentAlignment="Left" FontSize="12" Click="btnComplainUser_Click">
                <Button.Style>
                    <Style BasedOn="{StaticResource MaterialDesignFlatButton}" TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger  Binding="{Binding IsAuthor}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Content="🚩 Заморозить автора" Grid.Row="4" HorizontalContentAlignment="Left" FontSize="12">
                <Button.Style>
                    <Style BasedOn="{StaticResource MaterialDesignFlatButton}" TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger  Binding="{Binding IsAuthor}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
        <ScrollViewer Grid.Column="1" Grid.Row="1" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
            <Grid Margin="15 5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SelectedBook.Title}" Style="{StaticResource H1Text}"/>
                    <Button Content="Добавить в список"  Style="{StaticResource MaterialDesignRaisedLightButton}" FontWeight="Black" Foreground="White" Grid.Column="1" HorizontalAlignment="Right" Click="BtnAddList_Click" />

                </Grid>

                
                <TextBlock Grid.Row="1" Margin="0 5">
                <Run Text="Автор" Foreground="#FF70778F" FontSize="15"/>
                <Run Text="{Binding SelectedBook.User.DisplayName}" Foreground="#FF3D3DC7"  FontSize="15" />
                </TextBlock>

                <StackPanel Grid.Row="2" HorizontalAlignment="Left"  Margin="10 5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="Star"  Foreground="#FFFF5E1A"/>
                        <TextBlock Grid.Row="1" HorizontalAlignment="Center" Margin="3 0"
                            Text="{Binding SelectedBook.RatingFive}" Foreground="#FF3B393F" FontWeight="Bold" FontSize="15"/>
                    </StackPanel>
                    <TextBlock Text="{Binding GetCountReviews, StringFormat='\{0} оценок'}" Foreground="#626165" />
                    <!--<materialDesign:RatingBar  Value="4.3"/>-->
                </StackPanel>

                <TextBlock Text="О книге" Grid.Row="3"  Style="{StaticResource H4Text}" Margin="0 10 0 0"/>
                <TextBlock Grid.Row="4"  Style="{StaticResource DictText}"
                Text="{Binding SelectedBook.Description}" />

                <TextBlock Text="Жанры" Grid.Row="5"  Style="{StaticResource H4Text}" Margin="0 10 0 0"/>
                <TextBlock Grid.Row="6"  Style="{StaticResource DictText}" Text="{Binding AllGenresBook}" />

                <Grid Grid.Row="7" Margin="0 15 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Отзывы" Style="{StaticResource H4Text}" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GetCountReviews}"  Foreground="#FF70778F" FontSize="14"  Margin="8 0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="➕ Оставить отзыв" Grid.Row="3" Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalContentAlignment="Left" FontSize="12" HorizontalAlignment="Right" Click="btnAddReview_Click"/>
                </Grid>
                <ItemsControl Grid.Row="8"  d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="LstReviews" 
                              
                              HorizontalContentAlignment="Stretch"  ItemsSource="{Binding ReviewsBooks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0 8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Border CornerRadius="15" Width="30" Height="30" Margin="0 0 10 0">
                                            <Border.Background>
                                                <ImageBrush ImageSource="/NoneUserPath.png"/>
                                            </Border.Background>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding User.DisplayName}" Style="{StaticResource H4Text}" FontSize="12"/>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat='\{0} назад'}" FontSize="10" Margin="0 2" Foreground="#626165"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <materialDesign:RatingBar Grid.Column="1" IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Value="{Binding RatingFive}"  >
                                        <materialDesign:RatingBar.LayoutTransform >
                                            <ScaleTransform ScaleX="0.8" ScaleY="0.8"></ScaleTransform>
                                        </materialDesign:RatingBar.LayoutTransform>
                                    </materialDesign:RatingBar>
                                </Grid>
                                <Grid Grid.Row="1" >
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0 3" Style="{StaticResource ReviewText}" Text="{Binding Comment}"/>
                                    <Button Grid.Column="1"  Style="{StaticResource MaterialDesignFlatButton}" Padding="0" Width="30" Foreground="#FF673AB7" Height="30" VerticalAlignment="Bottom" Click="btnReviewPoints_Click" >
                                        <Button.Content>
                                            <materialDesign:PackIcon Kind="EllipsisVertical" Height="25" Width="25"/>
                                        </Button.Content>
                                        <!--<Button.Style>
                                            <Style TargetType="Button">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="Gray"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>-->
                                    </Button>

                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>

                    
                </ItemsControl>



            </Grid>

        </ScrollViewer>


    </Grid>
</Page>
