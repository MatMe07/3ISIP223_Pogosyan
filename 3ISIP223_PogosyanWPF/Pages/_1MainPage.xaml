<Page x:Class="_3ISIP223_PogosyanWPF.Pages._1MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_1MainPage" Background="White" Loaded="Page_Loaded">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>


        <Grid Margin="5 5 5 0" Grid.Row="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Row="0" BorderBrush="#FF9E9E9E" Background="White" BorderThickness="1" CornerRadius="5" Padding="0">
                <TextBox Grid.Column="0" x:Name="txtSearch"  Margin="5 0" FontSize="16"  BorderBrush="{x:Null}" />
                
            </Border>

            <Border Grid.Row="0" Grid.Column="1" Margin="5 0 0 0" Background="#BD257F" CornerRadius="5">
                <Button Content="Поиск" Width="100" Background='Transparent' BorderThickness="0" Foreground="White" HorizontalAlignment="Left" FontSize="17"  Click="ButtonSearch_Click"/>

            </Border>
            <!--<Button Grid.Row="0" Grid.Column="1" Content="Поиск" Width="100" HorizontalAlignment="Left" Margin="5 0 0 0" FontSize="17" FontWeight="Medium" Click="ButtonSearch_Click"/>-->
            <StackPanel  Grid.Row="0" Orientation="Horizontal" Grid.Column="2">
                <TextBlock Text="Сортировка:" x:Name="txt" Margin="5 0" FontSize="16"/>
                <ComboBox Width="130" x:Name="comboSort" FontSize="15" SelectionChanged="comboSort_SelectionChanged" >
                    <!--<ComboBoxItem Content="Все" IsSelected="True"/>
                    <ComboBoxItem Content="По названию"/>
                    <ComboBoxItem Content="По рейтингу"/>-->
                </ComboBox>
            </StackPanel>
            <StackPanel Grid.Row="1"  Background="#FFC3C3C8"  Height="1" Margin="0 10" Grid.ColumnSpan="3" />

        </Grid>

        <ListBox x:Name="lstFilms" Margin="0 0 0 10" Grid.Row="1" ItemsSource="{Binding Films}"  ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}" Background="Transparent" BorderBrush="{x:Null}" MouseDoubleClick="lstFilms_MouseDoubleClick" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel Width="160" >
                        <Grid>
                            <Image Source="{Binding PosterPath}" VerticalAlignment="Top" />
                            <Border Background="#FF3BB33B" Margin="5" MinWidth="32" HorizontalAlignment="Left" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Rating}" FontWeight="Medium" HorizontalAlignment="Center" Padding="2" FontSize="16" Foreground="White" VerticalAlignment="Center"/>
                            </Border>
                            <Border BorderThickness="1"  MinWidth="32" CornerRadius="5" BorderBrush="White" Background="#7F000000" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Age_Ratings.Name}" Padding="2" FontSize="16" Foreground="White" Margin="0 -1 0 0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Medium" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding ShowStartDate, StringFormat=C {0:MMMM dd}}" FontSize="14"  TextWrapping="Wrap" Foreground="Gray"/>
                            <!--<TextBlock Text="{Binding AgeRating}"/>-->
                        </StackPanel>
                    </WrapPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>


            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            
            
            <!--<ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False" />
                </Style>
            </ListBox.ItemContainerStyle>-->

        </ListBox>
        <DockPanel LastChildFill="False" Grid.Row="1"/>
    </Grid>
</Page>
