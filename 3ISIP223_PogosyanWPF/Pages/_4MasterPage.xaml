<Page x:Class="_3ISIP223_PogosyanWPF.Pages._4MasterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" d:Background="White"
      Title="_4MasterPage">

    <Page.DataContext>
        <local:MasterViewModel/>
    </Page.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Мои услуги" FontSize="20" FontWeight="Bold" Margin="5 0"/>

            <ListBox Grid.Row="1" 
                     ItemsSource="{Binding MasterServices}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                     MaxHeight="300" 
                     BorderBrush="{x:Null}" d:ItemsSource="{d:SampleData ItemCount=5}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="5" Padding="5 2">
                            <StackPanel>
                                <TextBlock Text="{Binding TypeService.Name}"/>
                                <StackPanel Orientation="Horizontal" Margin="0 5">
                                    <TextBlock Text="{Binding Price, StringFormat=💰 {0} ₽}"/>
                                    <TextBlock Text="{Binding DurationMinutes, StringFormat=⏱️ {0} мин}" Margin="5 0"/>
                                </StackPanel>
                                <Button Content="Удалить" Margin="0 0 0 5"
                                        Click="DeleteService_Click"
                                        Tag="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <Button Grid.Row="3" Margin="0 10" Content="Добавить" Click="AddService_Click"/>
        </Grid>

        <Grid Grid.Column="1" Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Мои записи" FontSize="20" FontWeight="Bold"/>

            <ListBox Grid.Row="1" x:Name="lstAppoints"
                     ItemsSource="{Binding MasterAppointments}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=5}"  SelectedItem="{Binding CurrentAppointment}" SelectionChanged="ListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#7F808080" CornerRadius="10" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="{Binding AppointmentDate, StringFormat=HH:mm}" 
                                           FontSize="25" FontWeight="Bold"/>
                                <TextBlock Text="{Binding AppointmentDate, StringFormat=dd.MM.yyyy}" 
                                           Grid.Row="1" FontSize="14" Margin="5 0"/>
                                <TextBlock Text="{Binding Service.TypeService.Name}" 
                                           Grid.Row="2" FontSize="14" Margin="5 0"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
        </Grid>
    </Grid>
</Page>