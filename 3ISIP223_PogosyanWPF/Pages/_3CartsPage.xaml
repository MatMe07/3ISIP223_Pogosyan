<Page x:Class="_3ISIP223_PogosyanWPF.Pages._3CartsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels"
      mc:Ignorable="d" d:Background="White"
      Title="_3CartsPage" d:Width="800">

    <Page.DataContext>
        <local:CartViewModel />
    </Page.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="КОРЗИНА" HorizontalAlignment="Center" FontSize="19" FontWeight="Medium" Grid.ColumnSpan="2" VerticalAlignment="Center"/>

        <Button Content="Назад" Grid.Column="0" HorizontalAlignment="Left" Click="BackButton_Click"/>

        <StackPanel Grid.Row="1" Margin="10 0 10 0" Grid.Column="1" HorizontalAlignment="Right">
            <TextBlock Text="{Binding TotalQuantity, StringFormat='Товары, {0} шт.'}" 
                       FontSize="15" Foreground="Gray" HorizontalAlignment="Right" />
            <TextBlock Text="{Binding TotalPrice, StringFormat='Итого: {0:F2} ₽'}" 
                       FontSize="17" FontWeight="Bold" HorizontalAlignment="Right"/>
            <Button Content="Оформить заказ" 
                    HorizontalAlignment="Right" Margin="0 10" 
                    Style="{StaticResource ConfirmButton}"
                    Click="CreateOrder_Click"/>
        </StackPanel>

        <ListBox Grid.Row="1" Grid.Column="0" 
                 ItemsSource="{Binding CartItems}" 
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"  d:ItemsSource="{d:SampleData ItemCount=5}" BorderBrush="{x:Null}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Black" BorderThickness="1" CornerRadius="10" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="{Binding Product.Name}" 
                                       Grid.Row="1" FontSize="13" TextWrapping="WrapWithOverflow" 
                                       Margin="5 0" FontWeight="Bold"/>

                            <Grid Grid.Row="2" Margin="10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                    <ColumnDefinition Width="auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Content="-" Grid.Column="0" MinWidth="20"
                                        Click="DecreaseQuantity_Click"
                                        Tag="{Binding}"/>

                                <StackPanel Grid.Column="1" Width="25" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Quantity}" FontSize="15" HorizontalAlignment="Center"/>
                                </StackPanel>

                                <Button Content="+" Grid.Column="2" MinWidth="20"
                                        Click="IncreaseQuantity_Click"
                                        Tag="{Binding}"/>
                            </Grid>

                            <StackPanel Grid.Row="3" >
                                <TextBlock FontSize="10" Margin="5 0" Text="{Binding Product.Price ,StringFormat='{}{0:F2} ₽'}" TextDecorations="Strikethrough"/>
                                <TextBlock FontSize="15" Margin="5 0" FontWeight="Medium" Text="{Binding Product.PriceWithDiscount ,StringFormat='{}{0:F2} ₽'}"/>

                            </StackPanel>

                            <Button Content="Удалить" Grid.Row="4" Margin="5"
                                    Style="{StaticResource DeleteButton}"
                                    Click="RemoveFromCart_Click"
                                    Tag="{Binding}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>