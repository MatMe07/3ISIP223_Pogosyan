<Page x:Class="_3ISIP223_PogosyanWPF.Pages._3CartsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" d:Background="White"
      Title="_3CartsPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>


        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="КОРЗИНА" HorizontalAlignment="Center" FontSize="19" FontWeight="Medium" Grid.Column="1" VerticalAlignment="Center"/>
            <Button Content="Назад" FontSize="14" Grid.Column="0" Padding="10 5" Margin="10"/>
        </Grid>
        
        
        <StackPanel Grid.Row="1" Margin="10">
            <TextBlock Text="Товары" FontSize="16" FontWeight="Medium" Margin="0 0 0 10"/>
            <ListBox d:ItemsSource="{d:SampleData ItemCount=2}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="{x:Null}" >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Black" BorderThickness="1" CornerRadius="10" Padding="10">
                            <Grid >
                                <Grid.RowDefinitions >
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="ШАМПУНЬ 'ОБЪЕМ'" Grid.Row="1" FontSize="15" Margin="5 0" FontWeight="Bold"/>
                                <Grid Grid.Row="2" Margin="10" HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Content="-" Grid.Column="0" Width="20"/>
                                    <TextBlock Text="2" FontSize="15" Grid.Column="1" Margin="10 0"/>
                                    <Button Content="+" Grid.Column="2" Width="20"/>
                                </Grid>
                                <TextBlock Text="1 798 ₽" Grid.Row="3" FontSize="15" Margin="5 0" FontWeight="Medium"/>
                                <Button Content="Удалить" Grid.Row="4" Margin="5"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>

                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="10">
            <TextBlock Text="Товары, 0 шт." FontSize="16" Foreground="Gray" Margin="0 5"/>
            <TextBlock Text="Итого: 777 910 ₽" FontSize="23" FontWeight="Bold"/>
        </StackPanel>

        <Button Content="Оформить заказ" Grid.Row="3" HorizontalAlignment="Center"/>
    </Grid>
</Page>
