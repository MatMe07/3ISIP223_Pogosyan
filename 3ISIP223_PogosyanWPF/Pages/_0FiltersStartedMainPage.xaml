<Page x:Class="_3ISIP223_PogosyanWPF.Pages._0FiltersStartedMainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_0FiltersStartedMainPage" d:Background="White">

    <Page.DataContext>
        <local:StartedMainView />
    </Page.DataContext>
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Фильтры" FontSize="20" FontWeight="Bold"/>
            <StackPanel Grid.Row="1" Margin="0 10">
                <TextBlock Text="Мастер" FontSize="16" Margin="0 5"/>
                <ComboBox Width="170"  IsEditable="True" ItemsSource="{Binding MastersStrings}" SelectedIndex="0" SelectedItem="{Binding SelectedMasterItemFilt}"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0 10">
                <TextBlock Text="Тип услуги" FontSize="16" Margin="0 5"/>
                <ComboBox Width="170"  IsEditable="True" ItemsSource="{Binding TypeServesStrings}" SelectedIndex="0" SelectedItem="{Binding SelectedUslugItemFilt}"/>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1" Grid.Column="1"  SelectedItem="{Binding SelectedMaster}" d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="lstMasters" ItemsSource="{Binding MasterSerives}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="lst_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="#7F6AA9AE" BorderThickness="3"  CornerRadius="10" Padding="10" Width="230">
                        <Grid >
                            <Grid.RowDefinitions >
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding FIO}" FontSize="18" Margin="0 0 0 5" FontWeight="Bold" TextWrapping="Wrap"/>

                            <TextBlock Text="Услуги:" Grid.Row="1" FontSize="16" FontWeight="Medium"/>
                            <TextBlock Text="{Binding Uslugi, StringFormat='\ - {0}'}" Grid.Row="2" FontSize="13" Margin="5 0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
