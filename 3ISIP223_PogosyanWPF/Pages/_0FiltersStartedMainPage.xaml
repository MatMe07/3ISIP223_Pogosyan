<Page x:Class="_3ISIP223_PogosyanWPF.Pages._0FiltersStartedMainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_0FiltersStartedMainPage" d:Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Фильтры" FontSize="20" FontWeight="Bold"/>
            <StackPanel Grid.Row="1" Margin="0 10">
                <TextBlock Text="Мастер" FontSize="16" Margin="0 5"/>
                <ComboBox Width="150"  IsEditable="True"/>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0 10">
                <TextBlock Text="Тип услуги" FontSize="16" Margin="0 5"/>
                <ComboBox Width="150"  IsEditable="True"/>
            </StackPanel>

            <Button Grid.Row="3" Margin="0 10" Content="Применить фильтры"/>
        </Grid>

        <ListBox Grid.Row="1" Grid.Column="1" d:ItemsSource="{d:SampleData ItemCount=5}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#7F808080" CornerRadius="10" Padding="10">
                        <Grid >
                            <Grid.RowDefinitions >
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Anna" FontSize="25" Margin="0 0 0 5" FontWeight="Bold"/>

                            <TextBlock Text="Услуги:" Grid.Row="1" FontSize="17" FontWeight="Medium"/>
                            <TextBlock Text="- Покраска" Grid.Row="2" FontSize="14" Margin="5 0"/>
                            <TextBlock Text="- Маникюр" Grid.Row="3" FontSize="14" Margin="5 0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>
    </Grid>
</Page>
