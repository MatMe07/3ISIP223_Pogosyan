<Page x:Class="_3ISIP223_PogosyanWPF.Pages.ModelAndTypeEngine"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ModelAndTypeEngine" Background="White">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="387">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Модель:"  FontSize="14"  Margin="5" Style="{StaticResource SubtitleText}" />
                <ComboBox x:Name="ComboModel" Width="140" FontSize="14" Margin="50 5 5 5" SelectionChanged="ComboModel_SelectionChanged" />
                
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Тип двигателя:" FontSize="14" Margin="5"  Style="{StaticResource SubtitleText}"/>
                <ComboBox x:Name="ComboTypeEngine" Width="140" FontSize="14" Margin="10 5 5 5" SelectionChanged="ComboTypeEngine_SelectionChanged"/>
                <TextBlock x:Name="DopPrice" Text="+ 0 ₽" Margin="5"  Style="{StaticResource SubtitleText}"/>
                
            </StackPanel>
            <!--<TextBlock x:Name="txtF" Text="f" HorizontalAlignment="Center"/>-->
        </StackPanel>
        <!--<TextBlock x:Name="TotalPrice" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="1" Margin="5" Grid.Column="1" Text="Итого: 8100000 ₽"/>-->

    </Grid>
</Page>
