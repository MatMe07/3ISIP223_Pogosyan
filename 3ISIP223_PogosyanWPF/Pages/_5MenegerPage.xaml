<Window x:Class="_3ISIP223_PogosyanWPF.Pages._5MenegerPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
        mc:Ignorable="d"
        Title="_5MenegerPage" Height="450" Width="800">
    <Grid>
        <TabControl HorizontalAlignment="Center" Height="434" VerticalAlignment="Center" Width="800">
            <TabItem Header="Записи" FontSize="16" FontWeight="Medium">
                <Grid Background="Transparent" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0 10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" />
                            <Button Content="Найти" Grid.Column="1" HorizontalAlignment="Left" Margin="10 0"/>
                        </Grid>
                        <ListBox Grid.Row="1" Height="90" d:ItemsSource="{d:SampleData ItemCount=5}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0 5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="👤 Погосян Эдик" Grid.Column="0" FontSize="16"/>

                                        <TextBlock Text="|"  Grid.Column="1" FontSize="16" Margin="10 0"/>

                                        <TextBlock Text="+7 901 903 04 19" Grid.Column="2" FontSize="16"/>

                                        <TextBlock Text="|"  Grid.Column="3" FontSize="16" Margin="10 0"/>

                                        <Button Content="Записать" Margin="10 0" Grid.Column="4"/>

                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <ListBox Grid.Row="1" Margin="10" d:ItemsSource="{d:SampleData ItemCount=5}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Black" BorderThickness="1" CornerRadius="10" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="📅 15.04.2026 10:00"  Grid.Row="0" FontSize="16"/>
                                        <TextBlock Text="Услуга: Маникюр"  Grid.Row="1" FontSize="16" Margin="0 5"/>
                                        <TextBlock Text="Мастер: Анна К."  Grid.Row="2" FontSize="16" Margin="0 5"/>
                                        <TextBlock Text="Клиент: Иванова А."  Grid.Row="3" FontSize="16"  Margin="0 5"/>
                                        <StackPanel Grid.Row="4" Orientation="Horizontal">
                                            <Button Content="Перенести" Margin="0 5" Style="{StaticResource ConfirmButton}"/>
                                            <Button Content="Отменить" Margin="5" Style="{StaticResource DeleteButton}"/>
                                        </StackPanel>
                                    </Grid>

                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>


                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </Grid>
            </TabItem>
            <TabItem Header="Заказы" FontSize="16" FontWeight="Medium">
                <Grid Background="Transparent">

                    <ListBox d:ItemsSource="{d:SampleData ItemCount=2}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="{x:Null}" >
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="🧾 ЗАКАЗ №1245" Grid.Column="0" Grid.Row="0" Margin="0 0 10 0"/>
                                    <TextBlock Text="Иванова Анна" Grid.Column="1" Grid.Row="0" Margin="10 0"/>
                                    <TextBlock Text="15.04.2026" Grid.Column="2" Grid.Row="0" Margin="10 0"/>
                                    <TextBlock Text="💳 Карта" Grid.Column="3" Grid.Row="0" Margin="10 0"/>
                                    <TextBlock Text="2 450 ₽" Grid.Column="4" Grid.Row="0" Margin="10 0"/>

                                    <Border Padding="5" Grid.Row="1" Grid.ColumnSpan="5" BorderThickness="1" Margin="0 5"  BorderBrush="Black" >
                                        <StackPanel>
                                            <TextBlock Text="📦 Шампунь 'Объем' x1, " Margin="0 0 0 15" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Статус: ⏳ ОЖИДАЕТ ВЫДАЧИ" Grid.Column="0"/>
                                                <Button Grid.Column="1" Content="Выдан" HorizontalAlignment="Right" Style="{StaticResource ConfirmButton}" Background="#FF63B287" />

                                            </Grid>

                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </TabItem>

            <TabItem Header="Товары" FontSize="16" FontWeight="Medium">
                <Grid Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Товары (15)" Margin="10"  />
                    <Button Grid.Column="1" Grid.Row="0" Content="Добавить" Style="{StaticResource ConfirmButton}" HorizontalAlignment="Right"/>
                    <ListBox d:ItemsSource="{d:SampleData ItemCount=4}" Grid.Row="1" Grid.ColumnSpan="2" ScrollViewer.HorizontalScrollBarVisibility="Disabled" BorderBrush="{x:Null}" >
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="5">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="ШАМПУНЬ 'ОБЪЕМ'" Grid.Column="0" Grid.Row="0" Margin="0 0 10 0"/>
                                    <TextBlock Text="L'Oreal" Grid.Column="1" Grid.Row="0" Margin="10 0"/>
                                    <TextBlock Text="1 200  →" Grid.Column="2" Grid.Row="0" Margin="10 0"/>
                                    <TextBlock Text="899 ₽" Grid.Column="3" Grid.Row="0" Margin="0 0"/>
                                    <TextBlock Text="☆ 4.2" Grid.Column="4" Grid.Row="0" Margin="10 0"/>
                                    <TextBlock Text="Активен" Grid.Column="5" Grid.Row="0" Margin="10 0"/>


                                    <Border Padding="5" Grid.Row="1" Grid.ColumnSpan="6" BorderThickness="1" Margin="0 5"  BorderBrush="Black" >
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Тип: Помада" Margin="0 0 0 15" />
                                                <TextBlock Text=" │ " Margin="0 0 0 15" />
                                                <TextBlock Text="Скидка: 21%" Margin="0 0 0 15" />
                                            </StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Button Grid.Column="0" Content="РЕДАКТИРОВАТЬ" Margin="5 0"  />
                                                <Button Grid.Column="1" Content="ЗАМОРОЗИТЬ"  Margin="5 0" Style="{StaticResource FreezeButton}" />
                                                <Button Grid.Column="2" Content="СКИДКА"  Margin="5 0" Style="{StaticResource ConfirmButton}" />
                                                <!--<Button Grid.Column="3" Content="УДАЛИТЬ"   Margin="5 0" Style="{StaticResource DeleteButton}"/>-->

                                            </Grid>

                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                </Grid>
            </TabItem>

            <TabItem  Header="Производители" FontSize="16" FontWeight="Medium">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <TextBlock Text="ПРОИЗВОДИТЕЛИ (15)" Margin="10"  />
                    <Button Grid.Column="1" Grid.Row="0" Content="Добавить" Style="{StaticResource ConfirmButton}" HorizontalAlignment="Right"/>

                    <ListBox d:ItemsSource="{d:SampleData ItemCount=6}"  Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" BorderBrush="{x:Null}"  Grid.Row="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Black" BorderThickness="1" Padding="5">
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="L'Oreal" Grid.Column="0" VerticalAlignment="Center" FontSize="20"/>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                                            <Button Content="✏️" MinWidth="40" Style="{StaticResource IconButton}" MinHeight="40" />
                                            <Button Content="🗑️" MinHeight="40" MinWidth="40" Style="{StaticResource IconButton}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </TabItem>

            <TabItem Header="Типы товаров" FontSize="16" FontWeight="Medium">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <TextBlock Text="Типы товаров (8)" Margin="10" />
                    <Button Grid.Column="3" Grid.Row="0" Content="Добавить" HorizontalAlignment="Right" Style="{StaticResource ConfirmButton}"/>

                    <ListBox d:ItemsSource="{d:SampleData ItemCount=6}"  Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" BorderBrush="{x:Null}" Grid.Row="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Black" BorderThickness="1" Padding="5">
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="Шампуни" Grid.Column="0" VerticalAlignment="Center" FontSize="20"/>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right">
                                            <Button Content="✏️" MinWidth="40" Style="{StaticResource IconButton}" MinHeight="40"/>
                                            <Button Content="🗑️" MinWidth="40" Style="{StaticResource IconButton}" MinHeight="40"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

            </TabItem>

            <TabItem Header="Услуги" FontSize="16" FontWeight="Medium">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <TextBlock Text="Типы услуг (8)" Margin="10" />
                    <Button Grid.Column="3" Grid.Row="0" Content="Добавить" HorizontalAlignment="Right" Style="{StaticResource ConfirmButton}"/>

                    <ListBox d:ItemsSource="{d:SampleData ItemCount=6}"  Grid.ColumnSpan="2" HorizontalContentAlignment="Stretch" BorderBrush="{x:Null}" Grid.Row="1">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="Black" BorderThickness="1" Padding="5">
                                    <Grid >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="auto"/>
                                            <RowDefinition Height="auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="Шампуни" Grid.Column="0" VerticalAlignment="Center" FontSize="20"/>
                                        <StackPanel Orientation="Horizontal" Grid.Column="1" HorizontalAlignment="Right" Grid.RowSpan="2">
                                            <Button Content="✏️" MinWidth="40" Style="{StaticResource IconButton}" MinHeight="40"/>
                                            <Button Content="🗑️" MinWidth="40" Style="{StaticResource IconButton}" MinHeight="40"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="1" Text="└─ Оказывают:" VerticalAlignment="Center" FontSize="18"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

            </TabItem>

        </TabControl>
    </Grid>
</Window>
