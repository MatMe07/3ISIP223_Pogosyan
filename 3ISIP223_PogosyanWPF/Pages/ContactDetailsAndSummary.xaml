<Page x:Class="_3ISIP223_PogosyanWPF.Pages.ContactDetailsAndSummary"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ContactDetailsAndSummary" Background="White" >

    <Grid  VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Имя: " FontSize="14"  Margin="5"/>
            <TextBox x:Name="textName"  FontSize="14"  Width="100" Margin="5" TextChanged="textName_TextChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal">
            <TextBlock Text="Телефон: " FontSize="14"  Margin="5"/>
            <TextBox x:Name="textTelephon" FontSize="14"   Width="100" Margin="5" TextChanged="textTelephon_TextChanged" PreviewTextInput="textTelephon_PreviewTextInput"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <TextBlock Text="Адрес электронной почты: " FontSize="14"  Margin="5"/>
            <TextBox x:Name="textEmail" Width="100" FontSize="14"  Margin="5" TextChanged="textEmail_TextChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <Button x:Name="btnSend"  Content="Отправить заявку" Width="150" FontSize="14" Margin="10" IsEnabled="False" />
        </StackPanel>

    </Grid>
</Page>
