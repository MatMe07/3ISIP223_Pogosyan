<Page x:Class="_3ISIP223_PogosyanWPF.Pages.ContactDetailsAndSummary"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ContactDetailsAndSummary" Background="White" >

    <Grid  VerticalAlignment="Center" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Vertical">
            <TextBlock Text="Имя: " FontSize="14" Style="{StaticResource SubtitleText}"  Margin="5"/>
            <TextBox x:Name="textName"  FontSize="16"  Width="160" Margin="5 0 5 10" HorizontalAlignment="Left" TextChanged="textName_TextChanged"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Vertical">
            <TextBlock Text="Телефон: " FontSize="14" Style="{StaticResource SubtitleText}"  Margin="5"/>
            <TextBox x:Name="textTelephon" FontSize="16"   Width="160" Margin="5 0 5 10" HorizontalAlignment="Left"  TextChanged="textTelephon_TextChanged" PreviewTextInput="textTelephon_PreviewTextInput"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Vertical">
            <TextBlock Text="E-mail: " FontSize="14"  Style="{StaticResource SubtitleText}" Margin="5"/>
            <TextBox x:Name="textEmail" Width="160" FontSize="16" Margin="5 0 5 10" HorizontalAlignment="Left"  TextChanged="textEmail_TextChanged"/>
        </StackPanel>

        <StackPanel Grid.Row="3">
            <Button x:Name="btnSend"  Content="Оформить заявку" Width="140" FontSize="14" Margin="10" IsEnabled="False" Height="26" Click="btnSend_Click" />
        </StackPanel>

    </Grid>
</Page>
