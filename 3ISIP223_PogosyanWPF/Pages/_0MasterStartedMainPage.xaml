<Page x:Class="_3ISIP223_PogosyanWPF.Pages._0MasterStartedMainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_0MasterStartedMainPage" d:Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Orientation="Horizontal" Margin="10">
            <TextBlock Text="Вы выбрали: Анна | Услуга: " VerticalAlignment="Center" FontSize="20"/>
            <ComboBox Width="100" Margin="5 0 10 0" IsEditable="True"/>
            
            <TextBlock Text="Дата: " VerticalAlignment="Center" FontSize="20"/>
            <DatePicker DisplayDate="12.02.2002" VerticalAlignment="Center" Margin="0 0 10 0"/>
            <Button  Content="Показать записи" VerticalAlignment="Center" FontSize="14" Padding="5"/>
        </WrapPanel>
        <TextBlock Text="Доступные записи" Grid.Row="1" FontWeight="Medium" Margin="10 10 10 10" VerticalAlignment="Center" FontSize="20"/>

        <ListBox Grid.Row="2" d:ItemsSource="{d:SampleData ItemCount=5}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" >
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="#7FFFCCCC" CornerRadius="10" Padding="10">
                        <Grid >
                            <Grid.RowDefinitions >
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                                <RowDefinition Height="auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="📅 15.04.2026" Grid.Row="0" FontSize="20" Margin="0 0 0 5" FontWeight="Bold"/>
                            <TextBlock Text="🕐 10:00" Grid.Row="1" FontSize="20" Margin="0 0 0 5" FontWeight="Bold"/>
                            <TextBlock Text="✨ Маникюр" Grid.Row="2" FontSize="20" Margin="0 0 0 5" FontWeight="Bold"/>
                            <TextBlock Text="👩 Анна" Grid.Row="3" FontSize="20" Margin="0 0 0 5" FontWeight="Bold"/>
                            <Button Content="Записаться" Margin="0 5" FontSize="18" Grid.Row="4"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
        </ListBox>

    </Grid>
</Page>
