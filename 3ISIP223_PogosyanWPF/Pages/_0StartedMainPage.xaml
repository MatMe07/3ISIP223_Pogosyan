<Page x:Class="_3ISIP223_PogosyanWPF.Pages._0StartedMainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_0StartedMainPage"
      d:Background="White">

    <Grid >

        
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Frame  Source="_0FiltersStartedMainPage.xaml" Grid.Row="1" x:Name="mainPageFrame" NavigationUIVisibility="Hidden"/>

        <StackPanel Orientation="Horizontal" Grid.Row="0" HorizontalAlignment="Right" >
            <Button Margin="10" Click="Button_Click">
                <TextBlock Text="Товары" FontSize="14"/>
            </Button>
            <Button Visibility="Visible" x:Name="AccountPageBtn"  Margin="10" Click="GoToAcc_Click">
                <TextBlock Text="Аккаунт"/>
            </Button>
            <Button Margin="10" x:Name="btnSign" Click="BtnSignIN_Click" >
                <TextBlock Text="Войти" FontSize="14" />
            </Button>
        </StackPanel>

    </Grid>
</Page>
