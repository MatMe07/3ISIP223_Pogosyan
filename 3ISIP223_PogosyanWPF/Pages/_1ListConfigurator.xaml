<Page x:Class="_3ISIP223_PogosyanWPF.Pages._1ListConfigurator"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_1ListConfigurator" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Системный блок" Grid.Column="0" FontSize="14" VerticalAlignment="Center" />
            <Button Content="Очистить конфигуратор" Grid.Column="1" HorizontalAlignment="Right" Cursor="Hand" >
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="ForceCursor" Value="True"/>
                        <Setter Property="Foreground" Value="Gray"/>

                        <Setter Property="Template">
                            <Setter.Value>
                                
                                <ControlTemplate TargetType="Button" >
                                    
                                    <Border Padding="3" Background="Transparent" >
                                        <ContentPresenter  />
                                    </Border>
                                    
                                    
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="Blue"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                                
                            </Setter.Value>
                        </Setter>
                        <!--<Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="Blue"/>
                                <Setter Property="Background" Value="Black"/>
                            </Trigger>
                        </Style.Triggers>-->
                    </Style>
                </Button.Style>
            </Button>
        </Grid>


        <Border Grid.Row="1" Visibility="Visible" Padding="10" Margin="0 10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
            <!--<WrapPanel>-->
            <Grid >
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Процессор" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                <Border Grid.Column="1" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                    <Button Content="Добавить" Padding="7"  BorderThickness="0" Background="Transparent"/>
                </Border>

            </Grid>
            <!--</WrapPanel>-->
        </Border>
        <Border Grid.Row="1" Visibility="Collapsed" Padding="10" Margin="0 10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
            <!--<WrapPanel>-->
            <Grid >
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Image Source="/proc.jpg" Width="40" Grid.Column="0" Margin="5 0 10 0"/>
                <StackPanel Grid.Column="1" Margin="5 0 10 0">
                    <TextBlock Text="Процессор AMD Ryzen 5 3600 OEM" FontSize="14"/>
                    <TextBlock Text="AM4, 6-ядерный, 3600 МГц, Turbo: 4200 МГц, Matisse, Кэш L2 - 3 Мб, L3 - 32 Мб, 7 нм, TDP 65 Вт" Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="2" Text="6 550 ₽" FontSize="14" VerticalAlignment="Center" Margin="20 0"/>


                <WrapPanel Grid.Column="3" VerticalAlignment="Center">
                    <Border HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                        <Button BorderThickness="0" Background="Transparent">
                            <Image Source="/proc.jpg" Width="32" Height="32" />
                        </Button>
                    </Border>
                    <Border Margin="5 0 0 0" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                        <Button  BorderThickness="0" Background="Transparent">
                            <Image Source="/proc.jpg" Width="32" Height="32" />

                        </Button>
                    </Border>
                    
                </WrapPanel>

            </Grid>
            <!--</WrapPanel>-->
        </Border>

        <Border Grid.Row="2" Visibility="Visible" Padding="10" Margin="0 10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
            <!--<WrapPanel>-->
            <Grid >
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Материнская карта" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                <Border Grid.Column="1" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                    <Button Content="Добавить" Padding="7"  BorderThickness="0" Background="Transparent"/>
                </Border>

            </Grid>
            <!--</WrapPanel>-->
        </Border>

        <Border Grid.Row="3" Visibility="Visible" Padding="10" Margin="0 10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
            <!--<WrapPanel>-->
            <Grid >
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Блок питания" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                <Border Grid.Column="1" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                    <Button Content="Добавить" Padding="7"  BorderThickness="0" Background="Transparent"/>
                </Border>

            </Grid>
            <!--</WrapPanel>-->
        </Border>

        <Border Grid.Row="4" Visibility="Visible" Padding="10" Margin="0 10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
            <!--<WrapPanel>-->
            <Grid >
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Корпус" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                <Border Grid.Column="1" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                    <Button Content="Добавить" Padding="7"  BorderThickness="0" Background="Transparent"/>
                </Border>

            </Grid>
            <!--</WrapPanel>-->
        </Border>

        <Border Grid.Row="5" Visibility="Visible" Padding="10" Margin="0 10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
            <!--<WrapPanel>-->
            <Grid >
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Видеокарта" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                <Border Grid.Column="1" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                    <Button Content="Добавить" Padding="7"  BorderThickness="0" Background="Transparent"/>
                </Border>

            </Grid>
            <!--</WrapPanel>-->
        </Border>

        <Border Grid.Row="6" Visibility="Visible" Padding="10" Margin="0 10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
            <!--<WrapPanel>-->
            <Grid >
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Кулер" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                <Border Grid.Column="1" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                    <Button Content="Добавить" Padding="7"  BorderThickness="0" Background="Transparent"/>
                </Border>

            </Grid>
            <!--</WrapPanel>-->
        </Border>

        <Border Grid.Row="7" Visibility="Visible" Padding="10" Margin="0 10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
            <!--<WrapPanel>-->
            <Grid >
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Накопитель" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                <Border Grid.Column="1" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                    <Button Content="Добавить" Padding="7"  BorderThickness="0" Background="Transparent"/>
                </Border>

            </Grid>
            <!--</WrapPanel>-->
        </Border>

        <Border Grid.Row="8" Visibility="Visible" Padding="10" Margin="0 10" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
            <!--<WrapPanel>-->
            <Grid >
                <Grid.ColumnDefinitions >
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Оперативная память" Grid.Column="0" VerticalAlignment="Center" FontSize="14"/>
                <Border Grid.Column="1" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                    <Button Content="Добавить" Padding="7"  BorderThickness="0" Background="Transparent"/>
                </Border>

            </Grid>
            <!--</WrapPanel>-->
        </Border>

    </Grid>
</Page>
