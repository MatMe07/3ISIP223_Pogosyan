                            <Button x:Name="btnDelete" Tag="{Binding Tag, ElementName=panelCPU}" BorderThickness="0" Background="Transparent" Width="32" Height="32" Click="btnDelete_Click">
                                <Image Source="https://img.icons8.com/fluency-systems-regular/45/delete--v1.png" Width="25" Height="25" />
                            </Button>
                        </Border>
                        <Border Margin="10 0 0 0" HorizontalAlignment="Right" BorderThickness="1" BorderBrush="Gray" CornerRadius="5">
                            <Button x:Name="btnEdit" Tag="{Binding Tag, ElementName=panelCPU}" BorderThickness="0" Background="Transparent" Width="32" Height="32" Click="btnEdit_Click">
                                <Image Source="https://img.icons8.com/ios-glyphs/45/refresh--v1.png" Width="25" Height="25" />

                            </Button>
                        </Border>

                    </WrapPanel>

                </Grid>
                <!--</WrapPanel>-->
            </Border>


