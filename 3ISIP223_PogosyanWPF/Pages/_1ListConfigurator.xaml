                <Border x:Name="IsRight" Visibility="Collapsed" BorderThickness="1" CornerRadius="5" Width="8" Height="8" Background="{Binding IsAllGoodBrush}" Margin="0 0 4 0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding CountConfig, StringFormat='\{0}/7'}" FontSize="13" FontWeight="Light" VerticalAlignment="Center"/>
                
            </StackPanel>
            <ProgressBar  x:Name="progreses" Grid.Row="1" Grid.ColumnSpan="3" Value="{Binding CountConfig}" Minimum="0" Maximum="7" Height="5" Background="#F1F1F1" BorderThickness="0" Margin="0 10 0 0"  ValueChanged="progreses_ValueChanged"/>

        </Grid>


        <Border x:Name="panAddCPU" Grid.Row="1" Visibility="Visible" Padding="10" Margin="0 10 0 0" BorderThickness="0 1 0 0" BorderBrush="#F1F1F1">
