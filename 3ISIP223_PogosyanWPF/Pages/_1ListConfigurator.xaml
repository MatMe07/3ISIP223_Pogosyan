                    <StackPanel Grid.Column="1" Margin="5 0 10 0" >
                        <TextBlock Text="{Binding Cpu.FullName}"  TextWrapping="WrapWithOverflow" FontSize="14"/>
                        <TextBlock Text="{Binding Cpu.Description}" Foreground="Gray" FontSize="12" TextWrapping="WrapWithOverflow"/>
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Cpu.basepart.price, StringFormat='\{0:F1} ₽'}" FontSize="14" VerticalAlignment="Center" Margin="20 0"/>


                <WrapPanel Grid.Column="3" VerticalAlignment="Center">
