<Page x:Class="_3ISIP223_PogosyanWPF.Pages.ProfilePages.ProfileMainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels.ProfileViewModels"
       xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:Background="White"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfileMainPage" Loaded="Page_Loaded">
    <Page.DataContext>
        <local:ProfileMainViewModel/>
    </Page.DataContext>
    <Grid>
        <StackPanel >
            <Grid Margin="10 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="0 5 50 5">
                    <materialDesign:PackIcon Kind="Account" Width="25" Height="25"/>
                    <TextBlock Text="Имя" VerticalAlignment="Center" Margin="5 0" FontSize="15" Foreground="#FF70778F"/>
                </StackPanel>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding User.DisplayName}" VerticalAlignment="Center" FontSize="15"/>
                
                <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" Margin="0 5 50 5">
                    <materialDesign:PackIcon Kind="AccountKey" Width="25" Height="25"/>
                    <TextBlock Text="Логин" VerticalAlignment="Center" Margin="5 0" FontSize="15" Foreground="#FF70778F"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding User.Login}" VerticalAlignment="Center" FontSize="15"/>
                
                <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="0" Margin="0 5 50 5">
                    <materialDesign:PackIcon Kind="Email" Width="25" Height="25"/>
                    <TextBlock Text="Email" VerticalAlignment="Center" Margin="5 0" FontSize="15" Foreground="#FF70778F"/>
                </StackPanel>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding User.Email}" VerticalAlignment="Center" FontSize="15"/>
                
                <StackPanel Orientation="Horizontal" Grid.Row="3" Grid.Column="0" Margin="0 5 50 5">
                    <materialDesign:PackIcon Kind="GuyFawkesMask" Width="25" Height="25"/>
                    <TextBlock Text="Роль" VerticalAlignment="Center" Margin="5 0" FontSize="15" Foreground="#FF70778F"/>
                </StackPanel>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding User.Role.RoleName}" VerticalAlignment="Center" FontSize="15"/>

            </Grid>
            <Border Visibility="{Binding User.IsUserVisibility}" Margin="10" Padding="15" CornerRadius="20"
                    
                    BorderThickness="1" Background="Transparent" materialDesign:ElevationAssist.Elevation="Dp2" MouseLeftButtonDown="btnAuthorRole_Click" >
                <Grid Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FountainPenTip" Foreground="#FF3D3DC7" Width="25" Height="25"/>
                        <TextBlock Text="Стать автором" FontSize="17" FontWeight="Bold" VerticalAlignment="Center" Margin="5 0"/>
                    </StackPanel>
                    <TextBlock Text="Для тех, кто не только читает книги, но и пишет их" FontSize="16" Grid.Row="1" Margin="0 5"/>

                </Grid>

                <Border.Style>
                    <Style TargetType="Border">
                        
                        <Style.Triggers >
                            <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="BorderBrush" Value="#D7D7F3"/>
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="False">
                            <Setter Property="BorderBrush" Value="#eaeaf9"/>
                        </Trigger>
                            
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
        </StackPanel>
        
        
    </Grid>
</Page>
