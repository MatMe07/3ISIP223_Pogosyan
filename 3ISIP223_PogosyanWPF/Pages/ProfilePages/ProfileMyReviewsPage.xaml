<Page x:Class="_3ISIP223_PogosyanWPF.Pages.ProfilePages.ProfileMyReviewsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages.ProfilePages"
       xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      d:Background="White"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ProfileMyReviewsPage">

    <Grid>
        <Grid HorizontalAlignment="Center" Visibility="Collapsed" x:Name="absenceVisible">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <materialDesign:PackIcon Kind="MessageText" Height="130" Width="130" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="У вас ещё нет отзывов" Margin="0 10 0 5" Style="{StaticResource H1Text}" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="2" Text="Когда оставите их, появятся здесь." 
                       FontSize="17"
                       Style="{StaticResource  MaterialDesignHeadline6TextBlock}" HorizontalAlignment="Center" Foreground="#FFA9A9B4"/>
        </Grid>
        <ItemsControl Visibility="Visible" Grid.Row="8"  d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="LstReviews"  HorizontalContentAlignment="Stretch"  ItemsSource="{Binding lstRand}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0 8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal">
                                <Border CornerRadius="5" Width="35" Height="35" Margin="0 0 10 0">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/NoneUserPath.png"/>
                                    </Border.Background>
                                </Border>
                                <StackPanel>
                                    <TextBlock Text="Название книги" Style="{StaticResource H4Text}" FontSize="14"/>
                                    <TextBlock Grid.Row="1" Margin="0 0">
                                        <Run Text="Автор" Foreground="#FF70778F" FontSize="13"/>
                                        <Run Text="Александр Пушкин" Foreground="#FF3D3DC7"  FontSize="13" />
                                    </TextBlock>
                                    <!--<TextBlock Text="7 дней назад" FontSize="10" Margin="0 2" Foreground="#626165"/>-->
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <materialDesign:RatingBar  IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Value="4.3"  >
                                    <materialDesign:RatingBar.LayoutTransform >
                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8"></ScaleTransform>
                                    </materialDesign:RatingBar.LayoutTransform>
                                </materialDesign:RatingBar>
                                <TextBlock Text="04 октября 2024, 18:39" FontSize="12" Margin="0 2" Foreground="#626165" HorizontalAlignment="Right"/>

                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" >
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0 3" Style="{StaticResource ReviewText}" Text="Классика. Бесценное произведение, которое не только открывает повод для раздумий над собственной жизнью, но и открывает мир идиостиля поэта, его личности"/>

                        </Grid>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>


        </ItemsControl>

    </Grid>
</Page>
