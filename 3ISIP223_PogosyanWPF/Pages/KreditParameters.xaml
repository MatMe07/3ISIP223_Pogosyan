<Page x:Class="_3ISIP223_PogosyanWPF.Pages.KreditParameters"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="KreditParameters" Background="White" Loaded="Page_Loaded">

    <Grid VerticalAlignment="Center">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock Text="Первоначальный взнос (%): " FontSize="14" Margin="5"/>
            <TextBox x:Name="textProcent" Margin="5" Width="100" FontSize="14" PreviewTextInput="textProcent_PreviewTextInput" TextChanged="textProcent_TextChanged_1" />

        </StackPanel>
        
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <TextBlock Text="Срок кредита: " FontSize="14" Margin="5"/>
            <Slider Width="150" Maximum="96" Minimum="12" Margin="5" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>
            <TextBlock x:Name="CountMounth" Text="12 мес." FontSize="14" Margin="5"/>

        </StackPanel>   
        
        <StackPanel Orientation="Horizontal" Grid.Row="2">
            <TextBlock Text="Годовая ставка: 12%" FontSize="14" Margin="5"/>
        </StackPanel>
        

        
        <StackPanel Grid.Row="3">
            <TextBlock x:Name="SumVznos" Text="Cумма первоначального взноса: 0 ₽" FontSize="14" Margin="5"/>
            <TextBlock x:Name="SumKredit" Text="Cумма кредита: 0 ₽" FontSize="14" Margin="5"/>
            <TextBlock x:Name="MonthPrice" Text="Ежемесячный платёж: 0 ₽" FontSize="14" Margin="5"/>

        </StackPanel>
        
        <!--<TextBlock Text="Hello" VerticalAlignment="Center" HorizontalAlignment="Center"/>-->
    </Grid>
</Page>
