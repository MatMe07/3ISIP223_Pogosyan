<Page x:Class="_3ISIP223_PogosyanWPF.Pages.KreditParameters"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="KreditParameters" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Grid.Row="0">
            <TextBlock Text="Процент первоначального взноса (%): " Height="16" FontSize="14" Margin="5"/>
            <TextBox x:Name="textProcent" Margin="5" Width="100" FontSize="14" Height="17"/>

        </StackPanel>
        <StackPanel Orientation="Horizontal" Grid.Row="1">
            <TextBlock Text="Процент первоначального взноса (%): " Height="16" FontSize="14" Margin="5"/>
            <Slider Width="100" Maximum="96" Minimum="12"/>

        </StackPanel>
        <!--<TextBlock Text="Hello" VerticalAlignment="Center" HorizontalAlignment="Center"/>-->
    </Grid>
</Page>
