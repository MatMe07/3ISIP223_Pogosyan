<Window x:Class="_3ISIP223_PogosyanWPF.Winodws.LoginRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
        Title="Вход / Регистрация" Height="500" Width="450"
          mc:Ignorable="d" d:Height="1000"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" >

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="1" FontSize="14">
            <TabItem Header="🔐 Вход">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Вход в аккаунт" FontSize="16" FontWeight="Bold" 
                               HorizontalAlignment="Center" Margin="0,0,0,20"/>

                    <TextBlock Grid.Row="1" Text="Телефон:" Margin="0,5"/>
                    <TextBox x:Name="txtLoginPhone" Grid.Row="2" Margin="0,5,0,15" Padding="8"/>

                    <TextBlock Grid.Row="3" Text="Пароль:" Margin="0,5"/>
                    <PasswordBox x:Name="txtLoginPassword" Grid.Row="4" Margin="0,5,0,20" Padding="8"/>

                    <Grid Grid.Row="5" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Отмена" Grid.Column="0" Margin="5" 
                                Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                        <Button Content="Войти" Grid.Column="1" Margin="5" 
                                Style="{StaticResource ConfirmButton}" Click="Login_Click"/>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="📝 Регистрация">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="Регистрация нового пользователя" FontSize="16" FontWeight="Bold" 
                                   HorizontalAlignment="Center" Margin="0,0,0,20"/>

                        <TextBlock Grid.Row="1" Text="Фамилия:" Margin="0,5"/>
                        <TextBox x:Name="txtRegLastName" Grid.Row="2" Margin="0,5,0,10" Padding="8"/>

                        <TextBlock Grid.Row="3" Text="Имя:" Margin="0,5"/>
                        <TextBox x:Name="txtRegFirstName" Grid.Row="4" Margin="0,5,0,10" Padding="8"/>

                        <TextBlock Grid.Row="5" Text="Отчество:" Margin="0,5"/>
                        <TextBox x:Name="txtRegSecondName" Grid.Row="6" Margin="0,5,0,10" Padding="8"/>

                        <TextBlock Grid.Row="7" Text="Телефон:" Margin="0,5"/>
                        <TextBox x:Name="txtRegPhone" Grid.Row="8" Margin="0,5,0,10" Padding="8"/>

                        <TextBlock Grid.Row="9" Text="Email:" Margin="0,5"/>
                        <TextBox x:Name="txtRegEmail" Grid.Row="10" Margin="0,5,0,10" Padding="8"/>

                        <TextBlock Grid.Row="11" Text="Пароль:" Margin="0,5"/>
                        <PasswordBox x:Name="txtRegPassword" Grid.Row="12" Margin="0,5,0,10" Padding="8"/>

                        <TextBlock Grid.Row="13" Text="Подтверждение пароля:" Margin="0,5"/>
                        <PasswordBox x:Name="txtRegConfirmPassword" Grid.Row="14" Margin="0,5,0,20" Padding="8"/>

                        <Grid Grid.Row="15" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Отмена" Grid.Column="0" Margin="5" 
                                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
                            <Button Content="Зарегистрироваться" Grid.Column="1" Margin="5" 
                                    Style="{StaticResource ConfirmButton}" Click="Register_Click"/>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</Window>