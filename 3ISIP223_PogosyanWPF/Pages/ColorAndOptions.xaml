<Page x:Class="_3ISIP223_PogosyanWPF.Pages.ColorAndOptions"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ColorAndOptions" Background="White">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="336">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Цвет:" Style="{StaticResource SubtitleText}" Margin="5" />
                <ComboBox x:Name="ComboColor" Width="90" FontSize="14" Margin="5" SelectionChanged="ComboColor_SelectionChanged" />

            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Доп. опции:"  Style="{StaticResource SubtitleText}"  Margin="5" />
                <StackPanel x:Name="StackOptions" Orientation="Vertical" >
                    
                </StackPanel>
            </StackPanel>
            <!--<TextBlock x:Name="txtF" Text="f" HorizontalAlignment="Center"/>-->
        </StackPanel>
        <!--<TextBlock x:Name="TotalPrice" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="1" Margin="5" Grid.Column="1" Text="Итого: 8100000 ₽"/>-->

    </Grid>
</Page>
