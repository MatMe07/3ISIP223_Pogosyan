<Page x:Class="_3ISIP223_PogosyanWPF.Pages.CalculatTotalCostAndParameters"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="CalculatTotalCostAndParameters" Background="White" Loaded="Page_Loaded">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Width="390">
            <TextBlock x:Name="TextModel" Style="{StaticResource SubtitleText}" Text="Модель: " Margin="3"/>
            <TextBlock x:Name="TextEngine"  Style="{StaticResource SubtitleText}" Text="Тип двигателя: " Margin="3"/>
            <TextBlock x:Name="TextColor"  Style="{StaticResource SubtitleText}" Text="Цвет: "  Margin="3"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Доп. опции: " Style="{StaticResource SubtitleText}" Margin="3"/>
                <TextBlock x:Name="StackDopOptions" Style="{StaticResource SubtitleText}" FontSize="15" Margin="3"/>
            </StackPanel>
            <TextBlock x:Name="TextTotalPrice" Style="{StaticResource SubtitleText}" Text="Итоговая стоимость: "  Margin="3"/>

        </StackPanel>
    </Grid>
</Page>
