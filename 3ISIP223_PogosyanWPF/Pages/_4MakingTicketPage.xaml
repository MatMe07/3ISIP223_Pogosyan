<Page x:Class="_3ISIP223_PogosyanWPF.Pages._4MakingTicketPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_4MakingTicketPage" Background="White">

    <ScrollViewer>
        
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="10 10 10 0">
                <!--<WrapPanel Orientation="Horizontal">-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="/600x900.jpg" Width="100" Stretch="Fill"  >
                    <Image.Clip>
                        <EllipseGeometry RadiusX="50" RadiusY="50" Center="50, 60"/>
                    </Image.Clip>
                </Image>
                <Grid Grid.Column="1" Margin="10 15 10 0" >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Column="1" Grid.Row="0" BorderThickness="1" CornerRadius="5"  BorderBrush="Gray" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="18 +" Padding="3" FontSize="19" Margin="0 -1 0 0"/>
                    </Border>

                    <TextBlock Grid.Column="0" Grid.Row="0" Text="Горничная" FontSize="35" FontWeight="Bold"/>
                
                    <Grid Grid.Row="1" Margin="0 5">
                        <Grid.ColumnDefinitions >
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                            <ColumnDefinition Width="auto"/>
                        </Grid.ColumnDefinitions>
                    
                        <TextBlock Grid.Column="0" Text="03 февраля 2026 в 12:35" Foreground="Gray" FontSize="14" />
                        <StackPanel Grid.Column="1" Background="Gray" Width="1"  Margin="10 0" />
                        <TextBlock Grid.Column="2" Text="Зал 6"  Foreground="Gray" FontSize="14"  />
                        <StackPanel Grid.Column="3" Background="Gray" Width="1"  Margin="10 0" />
                        <TextBlock Grid.Column="4" Text="2D"  Foreground="Gray" FontSize="14"  />

                    </Grid>
                </Grid>
                
                <!--</WrapPanel>-->
            </Grid>
            <StackPanel Grid.Row="1" Margin="10 0">
                <TextBlock Text="Билеты" FontSize="17" FontWeight="Medium"/>
                <StackPanel  Background="#FFC3C3C8" Height="1" Margin="0 10" />

                <ListBox ScrollViewer.HorizontalScrollBarVisibility="Disabled" d:ItemsSource="{d:SampleData ItemCount=2}" BorderBrush="{x:Null}" HorizontalAlignment="Left" Width="500" >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <WrapPanel  Margin="0 5">
                                <Border Background="Gray" CornerRadius="5">
                                    <Grid MinWidth="300" >
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Foreground="White" Grid.Column="0" Text="8 ряд, 3 место" Padding="15" FontSize="16"/>
                                        <TextBlock Foreground="White" Grid.Column="1" Text="210.00 ₽" HorizontalAlignment="Right" Padding="15" FontSize="16"/>
                                    </Grid>
                                </Border>
                            </WrapPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>
            <TextBlock Margin="15 5" Grid.Row="2" Text="Итого: 840.00 ₽" FontSize="23" FontWeight="Bold"/>
            <StackPanel Grid.Row="3" Background="#FFC3C3C8" Height="1" Margin="10 10" />
            <Border Grid.Row="4" Background="#BD257F" HorizontalAlignment="Left" CornerRadius="10" Margin="10">
                <Button Content="ПОДТВЕРДИТЬ" Padding="30 5" Background="Transparent" Foreground="White" FontSize="16" BorderBrush="{x:Null}" />
            </Border>

        </Grid>
        
    </ScrollViewer>
</Page>
