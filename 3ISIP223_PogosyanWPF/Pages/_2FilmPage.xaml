<Page x:Class="_3ISIP223_PogosyanWPF.Pages._2FilmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_2FilmPage" Background="White">
    
    <ScrollViewer>
        <Grid Margin="5">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/> 
                <RowDefinition Height="auto"/> 
                <RowDefinition Height="auto"/> 
                <RowDefinition Height="*"/> 
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <!--<Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    --><!--<RowDefinition Height="*"/>--><!--
                </Grid.RowDefinitions>-->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>

                </Grid.ColumnDefinitions>

                <Grid Grid.Row="0" Grid.Column="0" Margin="5" Height="300" VerticalAlignment="Top">
                    <Image Source="/600x900.jpg"  />
                    <Border BorderThickness="1" CornerRadius="5" BorderBrush="White" Background="#E5888888" Margin="5" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="16 +" Padding="2" FontSize="13" Foreground="White" Margin="0 -1 0 0"/>
                    </Border>
                </Grid>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10">
                    <TextBlock Text="Очень странные дела" FontSize="30" FontWeight="Bold" Margin="0 0 0 5"/>
                    <TextBlock Padding="0 0 5 0" FontSize="14" Text="1980-е годы, тихий провинциальный американский городок. Благоприятное течение местной жизни нарушает загадочное исчезновение подростка по имени Уилл." TextWrapping="Wrap"/>

                    <TextBlock Text="O фильме" Margin="0 10 0 5" FontSize="18" FontWeight="DemiBold"/>
                    <Grid Width="400" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="2*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Год производства" Grid.Row="0" Grid.Column="0" FontSize="14" Foreground="Gray" Margin="0 5"/>
                        <StackPanel Grid.Column="1" Grid.Row="0"  Margin="0 5">
                            <TextBlock Text="2016 (5 сезонов)"  FontSize="14"/>
                        </StackPanel>
                        <TextBlock Text="Жанр" Grid.Row="1" Grid.Column="0" FontSize="14" Foreground="Gray" Margin="0 5"/>
                        <StackPanel Grid.Column="1" Grid.Row="1">
                            <TextBlock FontSize="14" Text="ужасы, фантастика, фэнтези, триллер, драма, детектив" TextWrapping="Wrap" Margin="0 5"/>
                        </StackPanel>
                        <!--<TextBlock Text="Жанр" Grid.Row="2" Grid.Column="0" FontSize="14" Foreground="Gray" Margin="0 5"/>
                        <TextBlock Text="Жанр" Grid.Row="3" Grid.Column="0" FontSize="14" Foreground="Gray" Margin="0 5"/>
                        <TextBlock Text="Жанр" Grid.Row="4" Grid.Column="0" FontSize="14" Foreground="Gray" Margin="0 5"/>
                        <TextBlock Text="Жанр" Grid.Row="5" Grid.Column="0" FontSize="14" Foreground="Gray" Margin="0 5"/>
                        <TextBlock Text="Жанр" Grid.Row="6" Grid.Column="0" FontSize="14" Foreground="Gray" Margin="0 5"/>
                        <TextBlock Text="Жанр" Grid.Row="7" Grid.Column="0" FontSize="14" Foreground="Gray" Margin="0 5"/>-->
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="3" Margin="10" MinWidth="100" >
                    <TextBlock Text="8.2" FontSize="30"  FontWeight="Bold" Foreground="#FF3BB33B"/>
                </StackPanel>

            </Grid>
            
            <StackPanel Grid.Row="1" Background="#FFC3C3C8" Height="1" Margin="0 10" />

            <StackPanel  Grid.Row="2" Orientation="Horizontal" Margin="0 0 0 10">
                <TextBlock Text="Сортировка по залу:" VerticalAlignment="Center" Margin="10 0 5 0" FontSize="16"/>
                <ComboBox Width="130" x:Name="comboSort" FontSize="15" >
                    <ComboBoxItem Content="Все" IsSelected="True"/>
                    <ComboBoxItem Content="Standard"/>
                    <ComboBoxItem Content="Comfort"/>
                    <ComboBoxItem Content="VIP"/>
                    <ComboBoxItem Content="IMAX"/>
                    <ComboBoxItem Content="3D"/>
                </ComboBox>
            </StackPanel>
            

            <StackPanel Grid.Row="3">
                <ListBox d:ItemsSource="{d:SampleData ItemCount=5}" Background="{x:Null}" BorderBrush="{x:Null}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"  >
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <WrapPanel Orientation="Vertical" Margin="5 3">
                                <Border BorderBrush="Black" BorderThickness="1" CornerRadius="5">
                                    <Button  BorderBrush="{x:Null}" Background="{x:Null}" >
                                        <StackPanel Margin="2">
                                            <TextBlock Text="2026-01-31 11:13" FontSize="18" HorizontalAlignment="Center" FontWeight="Medium" />
                                            <TextBlock Text="750₽" Foreground="Gray" FontSize="14" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Border>
                                <TextBlock Text="2D" HorizontalAlignment="Center" FontSize="14"/>
                            </WrapPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!--<ListBox.ItemContainerStyle>
                        <Style>
                            <Setter TargetName="listbox">
                                
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>-->
                </ListBox>
                
                
                
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
