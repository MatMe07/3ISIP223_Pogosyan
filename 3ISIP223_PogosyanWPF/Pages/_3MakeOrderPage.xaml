<Page x:Class="_3ISIP223_PogosyanWPF.Pages._3MakeOrderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" d:DesignWidth="800"
      Title="_3MakeOrderPage" Background="White" Height="460">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"  Orientation="Horizontal" >
            <Button  Content="В корзину" Padding="4" FontSize="15" Margin="10" Click="btnBackToKorzina_Click"/>

        </StackPanel>

        <StackPanel Grid.Row="1" Margin="10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="ФИО:" Margin="0 0 20 0" FontSize="16"/>
                <TextBox x:Name="txtFIO" Width="180" FontSize="16" TextChanged="txtFIO_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Email:" Margin="0 0 20 0" FontSize="16"/>
                <TextBox x:Name="txtEmail" Width="180" FontSize="16" TextChanged="txtEmail_TextChanged"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Адрес доставки:" Margin="0 0 20 0" FontSize="16"/>
                <TextBox x:Name="txtAddress"  Width="200" FontSize="16" TextChanged="txtAddress_TextChanged"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="5">
            
            <TextBlock Text="ВАШ ЗАКАЗ:" Margin="5" FontSize="15" />
            <ListBox Margin="5" ItemsSource="{Binding Korzinas}" d:ItemsSource="{d:SampleData ItemCount=5}" Height="150">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <WrapPanel>
                            <WrapPanel>
                                <TextBlock x:Name="NameProduct" Text="{Binding Product.Name}" Margin="3" FontSize="15" ToolTip="{Binding Product.Name}" />
                                <TextBlock  Text="{Binding VivodPrice}" Margin="20 0 20 0" FontSize="17"/>

                            </WrapPanel>

                            <!--<TextBlock Text="{Binding TotalPrice, StringFormat=' {0} ₽' }" FontWeight="Black" Margin="3"  FontSize="16"/>-->

                        </WrapPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!--<StackPanel Orientation="Horizontal">-->
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="ИТОГО" FontSize="17" Margin="0 0 30 0" FontWeight="Bold"/>

                    <TextBlock Grid.Column="1" Text="{Binding TotalPrice, StringFormat=' {0} ₽'}" FontSize="17" FontWeight="Bold"/>
                </Grid>
            </StackPanel>
        <!--</StackPanel>-->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Подтвердить заказ" x:Name="btnMakingOrder" Margin="10" Padding="5" FontSize="16" Click="Button_Click" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Page>
