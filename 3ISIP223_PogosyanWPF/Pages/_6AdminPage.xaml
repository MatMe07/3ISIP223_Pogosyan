<Page x:Class="_3ISIP223_PogosyanWPF.Pages._6AdminPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" d:Background="White"
      Title="_6AdminPage">

    <Page.DataContext>
        <local:AdminViewModel/>
    </Page.DataContext>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding Users.Count, StringFormat=Пользователи ({0})}" Margin="10" FontSize="15"/>
        <Button Grid.Column="1" Grid.Row="0" Content="Добавить" HorizontalAlignment="Right" 
                Style="{StaticResource ConfirmButton}" Click="AddUser_Click"/>

        <ListBox ItemsSource="{Binding Users}" 
                 SelectedItem="{Binding SelectedUser}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                 HorizontalContentAlignment="Stretch" 
                 BorderBrush="{x:Null}" 
                 Grid.Row="1" Grid.ColumnSpan="2" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="{Binding FIO}" 
                                   Grid.Row="0" Margin="0 0 10 0" FontSize="15"/>

                        <Border Padding="5" Grid.Row="1" BorderThickness="1" Margin="0 5" BorderBrush="Black">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0 0 0 15">
                                    <TextBlock Text="{Binding Phone, StringFormat=Тел: {0}}" FontSize="15"/>
                                    <TextBlock Text=" │ " FontSize="15"/>
                                    <TextBlock Text="{Binding Email, StringFormat=Почта: {0}}" FontSize="15"/>
                                </StackPanel>

                                <Grid Margin="0 0 0 15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60"/>
                                        <ColumnDefinition Width="auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="25"/>
                                        <RowDefinition Height="auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Text="Роль: " Grid.Column="0" FontSize="15"/>
                                    <TextBlock Text="{Binding TypeRole.Name}" Grid.Column="1" FontSize="15"/>


                                    <TextBlock Text="Статус: " Grid.Column="0" Grid.Row="1" FontSize="15"/>
                                    <TextBlock Grid.Column="1" Grid.Row="1" FontSize="15">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="АКТИВЕН"/>
                                                <Setter Property="Foreground" Value="Green"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                        <Setter Property="Text" Value="ЗАМОРОЖЕН"/>
                                                        <Setter Property="Foreground" Value="Red"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Content="РЕДАКТИРОВАТЬ" Margin="10 0" 
                                            Click="EditUser_Click" Tag="{Binding}"/>
                                    <Button Grid.Column="1" Content="ЗАМОРОЗИТЬ" Margin="10 0" 
                                            Click="FreezeUser_Click" Tag="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource FreezeButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="1" Content="РАЗМОРОЗИТЬ" Margin="10 0" 
                                            Click="UnfreezeUser_Click" Tag="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource UnfreezeButton}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFrozen}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="2" Content="УДАЛИТЬ" Margin="10 0" 
                                            Style="{StaticResource DeleteButton}"
                                            Click="DeleteUser_Click" Tag="{Binding}"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>