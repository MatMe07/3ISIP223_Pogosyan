<Page x:Class="_3ISIP223_PogosyanWPF.Pages._2SelectComplect"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="703"
      Title="_2SelectComplect" Background="White" Loaded="Page_Loaded">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Оперативная память" FontSize="17" FontWeight="Medium"/>
            <Border Grid.Column="1" HorizontalAlignment="Right" BorderBrush="Black" CornerRadius="3" BorderThickness="1">
                <Button Content="Закрыть" FontSize="14" Padding="3" Background="Transparent" BorderBrush="Transparent"  Click="CloseClick_Click"/>
            </Border>

        </Grid>

        <StackPanel Background="#F1F1F1" Grid.Row="1" Grid.ColumnSpan="2" Height="1" Margin="10"/>


        <StackPanel Grid.Row="2" Grid.RowSpan="3" Grid.Column="0">

            <TextBlock Text="Фильтры" FontSize="15" FontWeight="Medium"/>
            <StackPanel Margin="0 10">
                <TextBlock Text="Производитель" FontSize="15" Margin="0 5" />
                <ComboBox x:Name="comboProizvod" IsEditable="True" Width="140" HorizontalAlignment="Left" FontSize="15" />
            </StackPanel>

        </StackPanel>


        <Border Grid.Row="2" Grid.Column="1" BorderThickness="1" BorderBrush="Gray" Background="Transparent" CornerRadius="3" Margin="5" Height="30">
            <TextBox FontSize="16" BorderThickness="0" Margin="4 0" Height="30"/>


        </Border>

        <ListBox x:Name="listComp" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="3" Grid.Column="1" Margin="5 10" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionChanged="listComp_SelectionChanged">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel Orientation="Horizontal">
                        <Image Source="{Binding basepart.image}" Width="80" Height="80" Margin="5"/>
                        <!--<Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>-->

                        <TextBlock Grid.Column="0" Margin="5 5" Text="{Binding FullDescription}" Width="300" TextWrapping="Wrap"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding basepart.price, StringFormat='\{0:F2} ₽'}" FontSize="15" FontWeight="Medium" HorizontalAlignment="Right" Margin="0 5"/>
                                <Border HorizontalAlignment="Right" BorderBrush="Gray" CornerRadius="3" BorderThickness="1">
                                    <Button Content="Добавить" FontSize="13" Padding="3" Background="Transparent" BorderBrush="Transparent" Click="btnAdd_Click"/>
                                </Border>

                            </StackPanel>
                        <!--</Grid>-->
                        <StackPanel Background="#F1F1F1" Height="1" Width="471"/>

                    </WrapPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>


            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>


        </ListBox>

    </Grid>
</Page>
