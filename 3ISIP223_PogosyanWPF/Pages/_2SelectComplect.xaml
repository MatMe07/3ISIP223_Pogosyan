<Page x:Class="_3ISIP223_PogosyanWPF.Pages._2SelectComplect"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="703"
      Title="_2SelectComplect" Background="White">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.5*" />
            <ColumnDefinition Width="1.5*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Оперативная память" FontSize="17" FontWeight="Medium"/>
            <Border Grid.Column="1" HorizontalAlignment="Right" BorderBrush="Black" CornerRadius="3" BorderThickness="1">
                <Button Content="Закрыть" FontSize="14" Padding="3" Background="Transparent" BorderBrush="Transparent"/>
            </Border>

        </Grid>

        <StackPanel Background="#F1F1F1" Grid.Row="1" Grid.ColumnSpan="2" Height="1" Margin="10"/>


        <WrapPanel Grid.Row="2" Grid.RowSpan="3" Grid.Column="0">

            <TextBlock Text="Фильтры" FontSize="15" FontWeight="Medium"/>
            <StackPanel Margin="0 10">
                <TextBlock Text="Производитель" FontSize="15" Margin="0 5" />
                <ComboBox Width="140" HorizontalAlignment="Left" FontSize="15" />
            </StackPanel>

        </WrapPanel>


        <Border Grid.Row="2" Grid.Column="1" BorderThickness="1" BorderBrush="Gray" Background="Transparent" CornerRadius="3" Margin="5" Height="30">
            <TextBox FontSize="16" BorderThickness="0" Margin="4 0" Height="30"/>


        </Border>

        <ListBox BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Grid.Row="3" Grid.Column="1" Margin="5 10" d:ItemsSource="{d:SampleData ItemCount=5}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <WrapPanel Orientation="Horizontal">
                        <Image Source="/proc.jpg" Width="90" Height="90" Margin="5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Margin="5 0" Text="Процессор AMD Ryzen 7 7800X3D OEM [AM5, 8 x 4.2 ГГц, L2 - 8 МБ, L3 - 96 МБ, 2 х DDR5-5200 МГц, AMD Radeon Graphics, TDP 120 Вт]" Width="300" TextWrapping="Wrap"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="32 499 ₽" FontSize="17" FontWeight="Medium" HorizontalAlignment="Right" Margin="0 5"/>
                                <Border HorizontalAlignment="Right" BorderBrush="Gray" CornerRadius="3" BorderThickness="1">
                                    <Button Content="Добавить" FontSize="14" Padding="3" Background="Transparent" BorderBrush="Transparent"/>
                                </Border>

                            </StackPanel>
                        </Grid>
                        <StackPanel Background="#F1F1F1" Height="1" Width="471"/>

                    </WrapPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>


            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

        </ListBox>

    </Grid>
</Page>
