<Page x:Class="_3ISIP223_PogosyanWPF.Pages._3SessionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_3SessionPage" Background="White">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Border  HorizontalAlignment="Left" BorderBrush="Gray" Margin="10 5 0 0" BorderThickness="1" CornerRadius="5">
            <Button Grid.Row="0" Content="Назад" Padding="5" FontSize="15" Width="60" BorderBrush="{x:Null}" Background="Transparent" Click="btnBack_Click" />
        </Border>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <TextBlock x:Name="txt" Text="ЭКРАН" HorizontalAlignment="Center" Margin="0" FontSize="16" Foreground="Gray" FontWeight="Medium"/>
            <Ellipse Width="400" Height="60" Stroke="Gray" StrokeThickness="3">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="15" Opacity="0.5" ShadowDepth="3" Direction="311"/>
                </Ellipse.Effect>
                <Ellipse.Clip>
                    <RectangleGeometry Rect="0,0,400,25"/>
                </Ellipse.Clip>
            </Ellipse>
        </StackPanel>

        <WrapPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Vertical" >
            <Grid x:Name="gridMesta" HorizontalAlignment="Center">
                <!--<Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button x:Name="btn1" Content="First Button" Grid.Row="0" Grid.Column="0"  />
                <Button x:Name="btn11" Content="First Button" Grid.Row="0" Grid.Column="1"  />
                <Button Content="First Button" Grid.Row="0" Grid.Column="2"  />
                <Button Content="First Button" Grid.Row="0" Grid.Column="3"  />
                <Button Content="First Button" Grid.Row="0" Grid.Column="4"  />
                <Button Content="First Button" Grid.Row="0" Grid.Column="5"  />
                <Button Content="First Button" Grid.Row="0" Grid.Column="6"  />
                <Button x:Name="btn2" Content="Second Button" Grid.Row="0" Grid.Column="2" />
                <Button x:Name="btn3" Content="Third Button" Grid.Row="1" Grid.Column="0"  />
                <Button x:Name="btn4" Content="Fourth Button" Grid.Row="1" Grid.Column="1" />
                <Button x:Name="btn5" Content="Fifth Button" Grid.Row="1" Grid.Column="2" />
                <Button x:Name="btn6" Content="Six Button" Grid.Row="2" Grid.Column="1"  />-->
            </Grid>
            <Grid Margin="10" >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="5">
                    <StackPanel Width="25" Height="25" Background="#4D82FF"/>
                    <StackPanel Margin="10 0 0 0">
                        <TextBlock Text="{Binding session.Hall.HallRating.Name}" FontSize="14" FontWeight="Medium"/>
                        <TextBlock Text="{Binding session.BasePrice, StringFormat='\{0} ₽'}" Foreground="Gray" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5">
                    <StackPanel Width="25" Height="25" Background="Gray"  />
                    <StackPanel Margin="10 0 0 0" VerticalAlignment="Center">
                        <TextBlock Text="Занято" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="5">
                    <StackPanel Width="25" Height="25" Background="#BD257F" />
                    <StackPanel Margin="10 0 0 0" VerticalAlignment="Center">
                        <TextBlock Text="Выбранное вами" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="5">
                    <CheckBox Margin="6 10 0 10" VerticalAlignment="Center" HorizontalAlignment="Center" Click="CheckBox_Click" />
                    <StackPanel Margin="10 0 0 0" VerticalAlignment="Center">
                        <TextBlock Text="Убрать занятые места" FontSize="14" FontWeight="Medium"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </WrapPanel>

        <StackPanel Grid.Row="3" x:Name="stackBtn" Visibility="Collapsed">
            <StackPanel  Background="#FFC3C3C8" Height="1" Margin="10 10" />

            
            <Border Background="#BD257F" HorizontalAlignment="Right" CornerRadius="10" Margin="10">
                <Button Content="{Binding StrTotalPrice, StringFormat='Далее: {0} ₽'}" Padding="30 5" MinWidth="130" Background="Transparent" Foreground="White" FontSize="16" BorderBrush="{x:Null}" Click="Button_Click" />
            </Border>

        </StackPanel>


    </Grid>
</Page>
