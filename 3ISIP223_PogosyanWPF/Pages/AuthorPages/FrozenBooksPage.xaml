<Page x:Class="_3ISIP223_PogosyanWPF.Pages.AuthorPages.FrozenBooksPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels.AuthorViewModels"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:Background="White"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="FrozenBooksPage">
    <Page.DataContext>
        <local:FrozenBooksViewModel/>
    </Page.DataContext>
    <Grid>
        <Grid HorizontalAlignment="Center" x:Name="absenceVisible">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <materialDesign:PackIcon Kind="BrainFreeze" Height="130" Width="130" HorizontalAlignment="Center"/>
            <TextBlock Grid.Row="1" Text="У вас нет замороженных книг" Margin="0 10 0 5" Style="{StaticResource H1Text}" HorizontalAlignment="Center"/>

            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFreezeBooks}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        </Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" >
            <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFreezeBooks}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ScrollViewer.Style>
            <ItemsControl  d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="LstFrozenBooks"  ItemsSource="{Binding Books}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0 8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="auto"/>
                                <ColumnDefinition Width="auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="120" Margin="0 0 10 0" HorizontalAlignment="Left">
                                <Image Source="{Binding CoverPath}"/>
                            </Border>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding Title}" Style="{StaticResource MaterialDesignHeadline5TextBlock}"  Margin="0 5"/>
                                <TextBlock Grid.Row="1" Text="{Binding Description}" TextWrapping="WrapWithOverflow" Style="{StaticResource ReviewText}" />

                            </Grid>
                            <StackPanel Grid.Column="2" Background="#33000000" Width="1" Margin="10 0"/>
                            <Grid Grid.Column="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                    <RowDefinition Height="auto"/>
                                </Grid.RowDefinitions>
                                <Button 
                                    materialDesign:ElevationAssist.Elevation="Dp0"  Tag="{Binding}"
                                    BorderThickness="0"  Click="btnChallengeBook_Click"
                                    >
                                    <Button.Content>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Kind="Shield"/>
                                            <TextBlock Text="Оспорить" Margin="5 0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button.Content>
                                </Button>
                                <materialDesign:ColorZone Grid.Row="1" Background="#FF1D7FD3" Padding="5 4" Foreground="White" >
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="BrainFreezeOutline" Width="20" Height="20"/>
                                        <TextBlock Text="{Binding CreatedAt, StringFormat='dd.MM.yyyy'}" Margin="10 0" VerticalAlignment="Center" FontSize="14"/>
                                    </StackPanel>
                                </materialDesign:ColorZone>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>


            </ItemsControl>

        </ScrollViewer>
    </Grid>
</Page>
