<Page x:Class="_3ISIP223_PogosyanWPF.Pages._7SignUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="_7SignUpPage" Background="White">

    <Grid>
        <Border BorderBrush="AliceBlue" Background="White" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Border.Effect>
                <DropShadowEffect Opacity="0.585" RenderingBias="Performance" ShadowDepth="1" BlurRadius="15" Direction="300"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border  HorizontalAlignment="Right" Grid.Column="1" BorderBrush="Gray" Margin="10 5 0 0" BorderThickness="1" CornerRadius="5">
                        <Button Grid.Row="0" Content="X" FontSize="15" Width="30" BorderBrush="{x:Null}" Background="{x:Null}" Click="btnBack_Click" />
                    </Border>
                    <TextBlock Margin="5" Grid.Column="0" Text="Регистрация" FontSize="20" HorizontalAlignment="Right" />

                </Grid>

                <Border Grid.Row="1" Width="250" BorderThickness="1" BorderBrush="Black" CornerRadius="5" Margin="10">
                    <StackPanel Margin="3">
                        <TextBlock Text="Имя" Margin="0 0 0 3" FontSize="15"/>
                        <TextBox x:Name="txtName" FontSize="16" BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="2"  Width="250" BorderThickness="1" BorderBrush="Black" CornerRadius="5" Margin="10">
                    <StackPanel Margin="3">
                        <TextBlock Text="Email" Margin="0 0 0 3"  FontSize="15"/>
                        <TextBox x:Name="txtEmail" FontSize="16" BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>
                <Border Grid.Row="3"  Width="250" BorderThickness="1" BorderBrush="Black" CornerRadius="5" Margin="10">
                    <StackPanel Margin="3">
                        <TextBlock Text="Дата рождения" Margin="0 0 0 3" FontSize="15"/>
                        
                        <!--<TextBox  FontSize="16" BorderThickness="0" Background="Transparent"/>-->

                        <DatePicker x:Name="txtBirthDate" SelectedDate="01.22.2007" FontSize="16" BorderThickness="0" >
                        </DatePicker>
                        
                    </StackPanel>
                </Border>
                <Border Grid.Row="4"   BorderThickness="1" BorderBrush="Black" CornerRadius="5" Margin="10">
                    <StackPanel Margin="3">
                        <TextBlock Text="Пароль" Margin="0 0 0 3" FontSize="15"/>
                        <TextBox x:Name="txtPassword"  FontSize="16" BorderThickness="0" Background="Transparent"/>
                    </StackPanel>
                </Border>
                <Button Grid.Row="5" Margin="10" Padding="8" FontSize="16" Content="Зарегистрироваться" Background="#BD257F" FontWeight="Medium" Foreground="White" Click="Button_Click" />
            </Grid>
        </Border>

    </Grid>
</Page>
