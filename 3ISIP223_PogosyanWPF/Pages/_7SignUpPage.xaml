<Page x:Class="_3ISIP223_PogosyanWPF.Pages._7SignUpPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      mc:Ignorable="d"
      Title="_7SignUpPage" Background="White" Height="430" Width="344">

    <Grid>
        <!--<Border BorderBrush="AliceBlue" Background="White" CornerRadius="5" HorizontalAlignment="Center" VerticalAlignment="Center" >
            <Border.Effect>
                <DropShadowEffect Opacity="0.585" RenderingBias="Performance" ShadowDepth="1" BlurRadius="15" Direction="300"/>
            </Border.Effect>-->
        <Grid>
            <Grid.RowDefinitions>
                <!--<RowDefinition Height="auto"/>-->
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>


            <Border Grid.Row="0" BorderThickness="1" BorderBrush="Black" CornerRadius="5" Margin="10">
                <StackPanel Margin="3">
                    <TextBlock Text="Имя" Margin="0 0 0 3" FontSize="15"/>
                    <TextBox x:Name="txtName" FontSize="16" BorderThickness="0" Background="Transparent"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1"  BorderThickness="1" BorderBrush="Black" CornerRadius="5" Margin="10">
                <StackPanel Margin="3">
                    <TextBlock Text="Email" Margin="0 0 0 3"  FontSize="15"/>
                    <TextBox x:Name="txtEmail" FontSize="16" BorderThickness="0" Background="Transparent"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="2"  BorderThickness="1" BorderBrush="Black" CornerRadius="5" Margin="10">
                <StackPanel Margin="3">
                    <TextBlock Text="Дата рождения" Margin="0 0 0 3" FontSize="15"/>

                    <!--<TextBox  FontSize="16" BorderThickness="0" Background="Transparent"/>-->

                    <DatePicker x:Name="txtBirthDate" SelectedDate="01.22.2007" FontSize="16" BorderThickness="0" >
                    </DatePicker>

                </StackPanel>
            </Border>
            <Border Grid.Row="3"  BorderThickness="1" BorderBrush="Black" CornerRadius="5" Margin="10">
                <StackPanel Margin="3">
                    <TextBlock Text="Пароль" Margin="0 0 0 3" FontSize="15"/>
                    <TextBox x:Name="txtPassword"  FontSize="16" BorderThickness="0" Background="Transparent"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="4"  BorderThickness="1" BorderBrush="Black" CornerRadius="5" Margin="10">
                <StackPanel Margin="3">
                    <TextBlock Text="Повторите пароль" Margin="0 0 0 3" FontSize="15"/>
                    <TextBox x:Name="txtPasswordAgain"  FontSize="16" BorderThickness="0" Background="Transparent"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="5"  Margin="10"  Background="#BD257F" CornerRadius="5" >
                <Button Padding="8" FontSize="16" Content="Зарегистрироваться" FontWeight="Medium" Foreground="White" Background="{x:Null}" BorderBrush="{x:Null}" Click="Button_Click" />

            </Border>
        </Grid>
        <!--</Border>-->

    </Grid>
</Page>
