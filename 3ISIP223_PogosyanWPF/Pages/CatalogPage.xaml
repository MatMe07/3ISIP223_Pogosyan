<Page x:Class="_3ISIP223_PogosyanWPF.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.ViewModels"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" d:Background="White"
      Title="CatalogPage">

    <Page.Resources>
        <ContextMenu x:Key="ReadingListMenu">
            <MenuItem Header="Заброшено" Tag="Заброшено"/>
            <MenuItem Header="В планах" Tag="В планах"/>
            <MenuItem Header="Читаю" Tag="Читаю"/>
            <MenuItem Header="Прочитано" Tag="Прочитано"/>
        </ContextMenu>
    </Page.Resources>

    <Page.DataContext>
        <local:CatalogViewModel />
    </Page.DataContext>
    <Grid >
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <materialDesign:ColorZone Grid.Row="0"
                              CornerRadius="3"
                                  Padding="10 10"
                              Background="#FFEAEAF9">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Border MinHeight="4"
                Background="White"
                CornerRadius="4"
                ToolTip="Enter to search, ignore case">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="SearchButton"
                    Width="40"
                    Height="40"
                    Style="{StaticResource MaterialDesignToolButton}">
                            <materialDesign:PackIcon Kind="Magnify" Opacity=".56" Height="25" Width="25" />
                        </Button>

                        <TextBox x:Name="SearchBox"
                     Grid.Column="1" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="15"
                     materialDesign:HintAssist.Hint="Поиск по названию или автору"
                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                     BorderThickness="0"
                     />
                    </Grid>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="0 10 0 0" Grid.Row="1">
                    <materialDesign:PackIcon Kind="FilterCogOutline" Height="25" Width="25"/>
                    <!--<Image Source="/Icons/icon-filter.png" Width="20"/>-->
                    <ComboBox Margin="5 0 20 0" Width="150" Padding="5" Background="White" Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="Сортировка" ItemsSource="{Binding SortStrings}" 
                              SelectedIndex="0"
                              SelectedItem="{Binding SelectedSortItem}">
                        <!--<ComboBoxItem Content="Все" IsSelected="True"/>
                        <ComboBoxItem Content="По названию"/>
                        <ComboBoxItem Content="По оценке"/>-->
                    </ComboBox>
                    <ComboBox Width="150" Padding="5" Background="White" 
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              SelectedItem="{Binding SelectedFiltItem}"
                              ItemsSource="{Binding FilterListStrings}"
                              materialDesign:HintAssist.Hint="Фильтрация">
                    </ComboBox>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <ListBox Grid.Row="1"  d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="listBooks"  ItemsSource="{Binding Books}" 
                 Style="{StaticResource MaterialDesignNavigationPrimaryListBox}" SelectionChanged="ListBox_SelectionChanged" >
            <ListBox.ItemTemplate >
                <DataTemplate >
                    <Grid Margin="5" Width="135">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border CornerRadius="10" ClipToBounds="True" Height="190" >
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding CoverPath}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Button Grid.Row="4" FontSize="13" Content="➕" Margin="0 5 5 0" Click="AddToListButton_Click" HorizontalAlignment="Right" 
                                    materialDesign:ElevationAssist.Elevation="Dp1" 
                                    VerticalAlignment="Top" Width="30" Height="30" Padding="0" Background="#99673AB7" BorderBrush="Transparent"/>

                        </Grid>
                        <TextBlock Text="{Binding Title}"  FontWeight="DemiBold" Grid.Row="1" Margin="0 3" TextWrapping="WrapWithOverflow"/>
                        <TextBlock Text="{Binding User.DisplayName}" Grid.Row="2"  Foreground="#FF5A617C" TextWrapping="WrapWithOverflow"/>
                        <TextBlock Text="{Binding RatingFive, StringFormat='★ {0}'}" Grid.Row="3"
                                   Margin="0 3 0 0"
                                   Foreground="#FF5A617C" TextWrapping="WrapWithOverflow"/>
                        <!--<Button Grid.Row="4" FontSize="11" Content="Добавить в список" Margin="0 5 0 0" Click="AddToListButton_Click"/>-->

                    </Grid>
                </DataTemplate>
                
            </ListBox.ItemTemplate>


            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            
            
        </ListBox>
        
    </Grid>
</Page>
