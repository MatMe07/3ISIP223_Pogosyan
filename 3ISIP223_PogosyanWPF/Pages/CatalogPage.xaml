<Page x:Class="_3ISIP223_PogosyanWPF.Pages.CatalogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:_3ISIP223_PogosyanWPF.Pages"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800" d:Background="White"
      Title="CatalogPage">

    <Page.Resources>
        <ContextMenu x:Key="ReadingListMenu">
            <MenuItem Header="Заброшено" Tag="Заброшено"/>
            <MenuItem Header="В планах" Tag="В планах"/>
            <MenuItem Header="Читаю" Tag="Читаю"/>
            <MenuItem Header="Прочитано" Tag="Прочитано"/>
        </ContextMenu>
    </Page.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>
            <TextBox  materialDesign:HintAssist.Hint="Поиск по названию или автору"
    Style="{StaticResource MaterialDesignOutlinedTextBox}"
    FontSize="15" Padding="10"/>
            <StackPanel Orientation="Horizontal" Margin="0 10" Grid.Row="1">
                <Image Source="/Icons/icon-filter.png" Width="20"/>
                <ComboBox Margin="10 0 20 0" Width="150" Padding="5" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                    <ComboBoxItem Content="hel"/>
                </ComboBox>
                <ComboBox Width="150" Padding="5" Style="{StaticResource MaterialDesignOutlinedComboBox}">
                    <ComboBoxItem Content="hel"/>
                </ComboBox>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="1"  d:ItemsSource="{d:SampleData ItemCount=5}" x:Name="listBooks"  ItemsSource="{Binding lst}" Style="{StaticResource MaterialDesignNavigationPrimaryListBox}" SelectionChanged="ListBox_SelectionChanged" >
            <ListBox.ItemTemplate >
                <DataTemplate >
                    <Grid Margin="5" Width="135">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                            <RowDefinition Height="auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Border CornerRadius="10" ClipToBounds="True" Height="190" >
                                <Border.Background>
                                    <ImageBrush ImageSource="/poster.jpg" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <Button Grid.Row="4" FontSize="13" Content="➕" Margin="0 5 0 0" Click="AddToListButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Width="30" Height="30" Padding="0"/>

                        </Grid>
                        <TextBlock Text="Евгений Онегин"  FontWeight="DemiBold" Grid.Row="1" Margin="0 3" TextWrapping="WrapWithOverflow"/>
                        <TextBlock Text="Александр Пушкин" Grid.Row="2"  Foreground="#FF5A617C" TextWrapping="WrapWithOverflow"/>
                        <TextBlock Text="★ 4,9" Grid.Row="3"  Foreground="#FF5A617C" TextWrapping="WrapWithOverflow"/>
                        <!--<Button Grid.Row="4" FontSize="11" Content="Добавить в список" Margin="0 5 0 0" Click="AddToListButton_Click"/>-->

                    </Grid>
                </DataTemplate>
                
            </ListBox.ItemTemplate>


            
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            
            
        </ListBox>
        
    </Grid>
</Page>
